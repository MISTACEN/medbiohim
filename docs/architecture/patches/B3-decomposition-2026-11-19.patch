diff --git a/workers/api/test/domain-source.js b/workers/api/test/domain-source.js
new file mode 100644
index 00000000..d99d68d4
--- /dev/null
+++ b/workers/api/test/domain-source.js
@@ -0,0 +1,18 @@
+// Роут разнесён на домен src/routes/<name>/: тест читает баррель и все файлы
+// домена, иначе проверки по тексту «проходят» по опустевшему баррелю.
+import { existsSync, readdirSync, readFileSync } from "node:fs";
+import { fileURLToPath } from "node:url";
+
+const BASE = new URL("../", import.meta.url);
+
+export function readDomain(relative) {
+  const file = fileURLToPath(new URL(relative, BASE));
+  const parts = [readFileSync(file, "utf8")];
+  const dir = file.replace(/\.ts$/, "");
+  if (existsSync(dir)) {
+    for (const name of readdirSync(dir).sort()) {
+      if (name.endsWith(".ts")) parts.push(readFileSync(dir + "/" + name, "utf8"));
+    }
+  }
+  return parts.join("\n");
+}
