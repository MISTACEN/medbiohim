+    });
+  }
+
+  const nav: { id: GroupId; label: string; Icon: ComponentType<{ className?: string }> }[] = [
+    { id: "plan", label: "План", Icon: GraduationCap },
+    ...(slug === "physiology" ? [{ id: "lessons" as GroupId, label: "Занятия", Icon: ListChecks }] : []),
+    { id: "tests", label: "Тесты", Icon: FileQuestion },
+    { id: "materials", label: "Материалы", Icon: FolderOpen },
+    { id: "practice", label: "Практика", Icon: FlaskConical },
+    ...(portal || externalPlatforms.length
+      ? [{ id: "portal" as GroupId, label: portal?.tabLabel || "Платформы", Icon: Globe }]
+      : []),
+    // Билеты и вопросы к экзамену объединены: это один и тот же банк.
+    { id: "attestations", label: "Экзамен · Аттестации", Icon: ClipboardList },
+    { id: "progress", label: "Прогресс", Icon: TrendingUp },
+  ];
+  const group = GROUP_OF[tab];
+  const subnav: { id: TabId; label: string }[] =
+    group === "tests"
+      ? [
+          { id: "tests", label: "Тесты" },
+          { id: "practice", label: "База вопросов" },
+        ]
+      : group === "materials"
+        ? [
+            // У физиологии лекции живут внутри занятий, отдельная вкладка не нужна.
+            ...(slug === "physiology" ? [] : [{ id: "lectures" as TabId, label: "Лекции" }]),
+            { id: "materials", label: "Материалы" },
+          ]
+        : group === "practice"
+          ? [
+              { id: "trainers", label: "Тренажёры" },
+              { id: "trainer", label: histology ? "Микропрепараты" : "Препараты" },
+              { id: "labs", label: "Лабораторные" },
+              ...(chemistry
+                ? [{ id: "chem" as TabId, label: subjectSubmodule?.tabs[0]?.label ?? "Структуры" }]
+                : []),
+              ...(latin ? [{ id: "latin" as TabId, label: "Рецепты" }] : []),
+            ]
+          : group === "attestations"
+            ? [
+                { id: "exam", label: "Экзамен / Билеты" },
+                { id: "attestations", label: "Аттестации" },
+                ...(slug === "physiology" ? [{ id: "colloquium" as TabId, label: "Коллоквиум" }] : []),
+              ]
+            : [];
+
+  return {
+    // состояние
+    tab,
+    setTab: selectTab,
+    selectTab,
+    group,
+    nav,
+    subnav,
+    loading,
+    error,
+    searchParams,
+    user,
+    // данные
+    subject,
+    subjectId,
+    slug,
+    course,
+    sem,
+    modules,
+    topicItems,
+    plan,
+    gradebook,
+    tests,
+    materials,
+    materialsRich,
+    lectures,
+    progress,
+    planProgress,
+    topicProgressById,
+    planSummary,
+    planSessions,
+    topicBusy,
+    resourceErrors,
+    subjectLibrary,
+    subjectLectures,
+    orderedLectures,
+    planLectureWeeks,
+    activeLecture,
+    setActiveLecture,
+    lectureLoading,
+    lectureError,
+    activeMaterial,
+    setActiveMaterial,
+    // признаки предмета
+    histology,
+    chemistry,
+    latin,
+    portal,
+    externalPlatforms,
+    subjectSubmodule,
+    // действия
+    cycleTopicStatus,
+    openTopicMaterial,
+    openLectureById,
+  };
+}
+
+export type SubjectController = ReturnType<typeof useSubjectPage>;
diff --git a/src/components/test-prep/AnswerVerdict.tsx b/src/components/test-prep/AnswerVerdict.tsx
new file mode 100644
index 00000000..67fb9fc5
--- /dev/null
+++ b/src/components/test-prep/AnswerVerdict.tsx
@@ -0,0 +1,89 @@
+"use client";
+
+/** Вердикт по ответу: верно/частично/ошибка, эталон и пояснение кафедры. */
+import { Loader2 } from "lucide-react";
+import { ChemRichText } from "@/modules/subjects/submodules/chemistry";
+import { ExplainWithAi } from "@/components/tests/ExplainWithAi";
+import { answerDisplay } from "@/components/test-prep/answers";
+import type { PreparationController } from "@/components/test-prep/usePreparation";
+import type { QuestionView } from "@/components/test-prep/view";
+
+export function AnswerVerdict({ page, view }: { page: PreparationController; view: QuestionView }) {
+  const { q, answers, checked, experience, loading, meta, subjectSlugForAi, retryGrading } = page;
+  const {
+    serverGrading,
+    staleAnswer,
+    unresolved,
+    correct,
+    partial,
+    isOpen,
+    isChecking,
+    reference,
+  } = view;
+  const reveal = checked[q.id] && experience === "prepare";
+
+  return (
+    <>
+      {isChecking && (
+        <div className="rounded-xl border border-indigo-200 bg-indigo-50 p-4 text-sm font-semibold text-indigo-900">
+          <span className="inline-flex items-center gap-2">
+            <Loader2 className="h-4 w-4 animate-spin" />
+            Проверяем ответ…
+          </span>
+          <div className="mt-1 text-xs font-normal opacity-70">Ответ сравнивается с эталоном на сервере.</div>
+        </div>
+      )}
+
+      {reveal && (
+        <div className={staleAnswer ? "rounded-xl bg-[var(--status-warn-bg)] p-4 text-[var(--status-warn-fg)]" : unresolved ? "rounded-xl bg-[var(--status-warn-bg)] p-4 text-[var(--status-warn-fg)]" : correct ? "rounded-xl bg-[var(--status-ok-bg)] p-4 text-[var(--status-ok-fg)]" : partial ? "rounded-xl bg-[var(--status-warn-bg)] p-4 text-[var(--status-warn-fg)]" : "rounded-xl bg-[var(--status-critical-bg)] p-4 text-[var(--status-critical-fg)]"}>
+          {staleAnswer
+            ? "↻ Ответ сохранён до исправления банка: варианты изменились, перепроверьте вопрос"
+            : unresolved
+            ? "↻ Ответ сохранён; автоматическая проверка по эталону невозможна"
+            : correct
+              ? "✓ Ответ засчитан"
+              : partial
+                ? "◐ Частично верно: выбрана часть эталонных вариантов"
+                : "✗ Ответ не засчитан"}
+          {serverGrading?.grading_source === "ai" ? <div className="mt-1 text-xs">Проверка смысла через ИИ</div> : null}
+          {serverGrading?.grading_feedback ? <div className="mt-1 text-sm">{String(serverGrading.grading_feedback)}</div> : null}
+          {reference ? (
+            <div className="mt-1 text-sm">
+              <span className="font-semibold">Правильный ответ: </span>
+              <ChemRichText text={reference} asHtml={isOpen} className="mt-1 whitespace-pre-wrap" />
+            </div>
+          ) : (
+            <div className="mt-1 text-sm">Эталон для этого вопроса не заполнен — ответ не считается ошибкой.</div>
+          )}
+          {unresolved ? (
+            <button type="button" disabled={loading} onClick={() => void retryGrading(q.id)} className="mt-2 rounded-lg border border-[var(--status-warn-border)] bg-white px-3 py-1.5 text-xs font-semibold text-[var(--status-warn-fg)] disabled:opacity-50">
+              Повторить проверку
+            </button>
+          ) : null}
+          {isOpen && (
+            <div className="mt-2 text-xs opacity-70">
+              Для развёрнутых задач учитывается смысл ответа; орфографические ошибки не должны снижать результат.
+            </div>
+          )}
+          {q.explanation ? (
+            <div className="mt-3 rounded-xl bg-white/70 p-3 text-left">
+              <div className="text-xs font-bold uppercase tracking-wide opacity-70">Пояснение кафедры</div>
+              <ChemRichText text={String(q.explanation)} className="mt-1 space-y-1" />
+            </div>
+          ) : null}
+        </div>
+      )}
+
+      {/* Разбор ошибки в один клик: тот же компонент, что в старом раннере. */}
+      {reveal && !unresolved && !isOpen && !correct && (
+        <ExplainWithAi
+          question={String(q.text || q.body || "")}
+          chosen={answerDisplay(q, answers[q.id])}
+          correct={reference}
+          subjectSlug={subjectSlugForAi || undefined}
+          subjectName={meta?.subject || undefined}
+        />
+      )}
+    </>
+  );
+}
diff --git a/src/components/test-prep/ChoiceAnswer.tsx b/src/components/test-prep/ChoiceAnswer.tsx
new file mode 100644
index 00000000..6f5a63ed
--- /dev/null
+++ b/src/components/test-prep/ChoiceAnswer.tsx
@@ -0,0 +1,98 @@
+"use client";
+
+/** Закрытый вопрос: варианты ответа, порядок и кнопка проверки. */
+import { ChemRichText } from "@/modules/subjects/submodules/chemistry";
+import { AnswerOption } from "@/components/questions/AnswerOption";
+import { optionLabel, type QuestionOption } from "@/components/test-prep/answers";
+import type { PreparationController } from "@/components/test-prep/usePreparation";
+import type { QuestionView } from "@/components/test-prep/view";
+
+export function ChoiceAnswer({ page, view }: { page: PreparationController; view: QuestionView }) {
+  const { q, checked, experience, answer, toggleOption } = page;
+  const {
+    options,
+    displayEntries,
+    correctOptionKeys,
+    isMulti,
+    selectedOptionKeys,
+    revealAnswers,
+    partial,
+    isChecking,
+  } = view;
+
+  return (
+    <>
+      {options.length === 0 && (
+        <div className="rounded-xl border border-[var(--status-warn-border)] bg-[var(--status-warn-bg)] p-4 text-sm text-[var(--status-warn-fg)]">
+          Это закрытый вопрос, но варианты ответа не заполнены в банке. Ответ можно дать текстом — он уйдёт на ручную проверку.
+        </div>
+      )}
+      {displayEntries.map(({ option: o, key, index }) => {
+        const label = optionLabel(o as QuestionOption);
+        const selected = selectedOptionKeys.includes(key);
+        const isCorrectOption = checked[q.id] && correctOptionKeys.has(key);
+        const position = q.requires_order && selected ? selectedOptionKeys.indexOf(key) + 1 : null;
+        return (
+          <AnswerOption
+            key={key + "-" + index}
+            as="label"
+            variant="choice"
+            state={
+              !revealAnswers
+                ? selected
+                  ? "selected"
+                  : "idle"
+                : isCorrectOption
+                  ? "correct"
+                  : selected
+                    ? partial
+                      ? "partial"
+                      : "wrong"
+                    : "idle"
+            }
+            badge={position ?? key}
+            badgeVariant="square"
+            leading={
+              <input
+                type={isMulti ? "checkbox" : "radio"}
+                name={"q-" + q.id}
+                checked={selected}
+                disabled={!!checked[q.id] || isChecking}
+                onChange={() => toggleOption(q, isMulti, key)}
+                className="mt-1"
+              />
+            }
+            trailing={
+              isCorrectOption ? (
+                <span className="rounded-full bg-[var(--status-ok-bg)] px-2 py-0.5 text-[10px] font-bold uppercase text-[var(--status-ok-fg)]">эталон</span>
+              ) : null
+            }
+          >
+            <ChemRichText text={label} className="flex-1 space-y-1" />
+          </AnswerOption>
+        );
+      })}
+      <div className="flex flex-wrap items-center gap-2">
+        <button
+          type="button"
+          disabled={!!checked[q.id] || isChecking || selectedOptionKeys.length === 0}
+          onClick={() => void answer(JSON.stringify(selectedOptionKeys))}
+          className="btn-primary"
+        >
+          {isChecking
+            ? "Проверяем…"
+            : experience === "prepare"
+              ? isMulti
+                ? "Проверить выбор"
+                : "Проверить ответ"
+              : isMulti
+                ? "Сохранить выбор"
+                : "Сохранить ответ"}
+        </button>
+        {q.requires_order && (
+          <span className="text-xs text-[var(--muted)]">Нажимайте варианты в нужной последовательности: номер выбора появится в квадрате.</span>
+        )}
+      </div>
+    </>
+  );
+}
diff --git a/src/components/test-prep/OtherAnswers.tsx b/src/components/test-prep/OtherAnswers.tsx
new file mode 100644
index 00000000..b95facb2
--- /dev/null
+++ b/src/components/test-prep/OtherAnswers.tsx
@@ -0,0 +1,124 @@
+"use client";
+
+/** Нетекстовые ветки ответа: пропуски, соответствия и развёрнутый текст. */
+import { ChemRichText } from "@/modules/subjects/submodules/chemistry";
+import { optionKey, optionLabel } from "@/components/test-prep/answers";
+import type { PreparationController } from "@/components/test-prep/usePreparation";
+import type { QuestionView } from "@/components/test-prep/view";
+
+export function ClozeAnswer({ page, view }: { page: PreparationController; view: QuestionView }) {
+  const { q, answers, checked, experience, answer, setAnswers } = page;
+  const { clozeBlanks, isChecking } = view;
+
+  return (
+    <>
+      <div className="space-y-2">
+        {Array.from({ length: clozeBlanks }, (_, blank) => {
+          const parts = (answers[q.id] || "").split(";");
+          return (
+            <div key={blank} className="flex items-center gap-2">
+              <span className="w-16 text-xs font-semibold text-slate-500">Пропуск {blank + 1}</span>
+              <input
+                value={parts[blank] || ""}
+                disabled={!!checked[q.id] || isChecking}
+                onChange={(e) => {
+                  const nextParts = [...parts];
+                  while (nextParts.length < clozeBlanks) nextParts.push("");
+                  nextParts[blank] = e.target.value;
+                  setAnswers((a) => ({ ...a, [q.id]: nextParts.join(";") }));
+                }}
+                className="flex-1 rounded-xl border p-2.5 text-sm outline-none focus:border-indigo-400"
+                placeholder={"Ответ " + (blank + 1)}
+              />
+            </div>
+          );
+        })}
+      </div>
+      <button
+        disabled={!!checked[q.id] || isChecking || !(answers[q.id] || "").trim()}
+        onClick={() => void answer(answers[q.id] || "")}
+        className="btn-primary"
+      >
+        {isChecking ? "Проверяем…" : experience === "prepare" ? "Проверить ответ" : "Сохранить ответ"}
+      </button>
+    </>
+  );
+}
+
+export function MatchAnswer({ page, view }: { page: PreparationController; view: QuestionView }) {
+  const { q, answers, checked, experience, answer, setAnswers } = page;
+  const { options, matchRights, isChecking } = view;
+
+  return (
+    <>
+      <div className="space-y-2">
+        {options.map((option, index) => {
+          const key = optionKey(option, index);
+          const selected = (() => {
+            try {
+              const parsed = JSON.parse(answers[q.id] || "[]");
+              return Array.isArray(parsed) ? String(parsed[index] ?? "") : "";
+            } catch { return ""; }
+          })();
+          return (
+            <div key={key} className="flex flex-wrap items-center gap-2">
+              <span className="min-w-40 flex-1 text-sm font-medium">
+                <ChemRichText text={optionLabel(option)} className="inline" />
+              </span>
+              <select
+                value={selected}
+                disabled={!!checked[q.id] || isChecking}
+                onChange={(e) => {
+                  try {
+                    const parsed = JSON.parse(answers[q.id] || "[]");
+                    const next = Array.isArray(parsed) ? [...parsed] : options.map(() => "");
+                    while (next.length < options.length) next.push("");
+                    next[index] = e.target.value;
+                    setAnswers((a) => ({ ...a, [q.id]: JSON.stringify(next) }));
+                  } catch {}
+                }}
+                className="min-w-48 rounded-xl border p-2 text-sm"
+              >
+                <option value="">— выберите —</option>
+                {matchRights.map((right) => (
+                  <option key={right} value={right}>{right}</option>
+                ))}
+              </select>
+            </div>
+          );
+        })}
+      </div>
+      <button
+        disabled={!!checked[q.id] || isChecking || !(answers[q.id] || "").trim() || answers[q.id] === "[]"}
+        onClick={() => void answer(answers[q.id] || "")}
+        className="btn-primary"
+      >
+        {isChecking ? "Проверяем…" : experience === "prepare" ? "Проверить соответствие" : "Сохранить ответ"}
+      </button>
+    </>
+  );
+}
+
+export function OpenAnswer({ page, view }: { page: PreparationController; view: QuestionView }) {
+  const { q, answers, checked, experience, answer, setAnswers } = page;
+  const { isChecking } = view;
+
+  return (
+    <>
+      <textarea
+        value={answers[q.id] || ""}
+        disabled={!!checked[q.id] || isChecking}
+        onChange={(e) => setAnswers((a) => ({ ...a, [q.id]: e.target.value }))}
+        placeholder="Введите свой ответ…"
+        className="min-h-40 w-full rounded-xl border p-4 text-sm outline-none focus:border-indigo-400"
+      />
+      <button
+        disabled={!!checked[q.id] || isChecking || !(answers[q.id] || "").trim()}
+        onClick={() => void answer(answers[q.id] || "")}
+        className="btn-primary"
+      >
+        {isChecking ? "Проверяем…" : experience === "prepare" ? "Проверить ответ" : "Сохранить ответ"}
+      </button>
+    </>
+  );
+}
