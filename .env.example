# MEDBIOHIM — Vercel / frontend test configuration
# Values below are placeholders only. Never commit real secrets to GitHub.

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY>
NEXT_PUBLIC_APP_NAME=Медбиохим

# Vercel server-side proxy target. Keep this out of browser/client bundles.
SPACEWEB_API_ORIGIN=https://YOUR-SPACEWEB-DOMAIN/api/v1

# Preview-only test mode: Cloudflare first, SpaceWeb as an HTTPS fallback.
# Set these in Vercel Preview only after both endpoints have valid TLS certificates.
CLOUDFLARE_API_ORIGIN=https://YOUR-CLOUDFLARE-WORKER.workers.dev/api/v1
MEDBIOHIM_CF_FIRST=false

# Optional Vercel-side Gemini proxy for AI features.
GEMINI_API_KEY=
GEMINI_VERCEL_PROXY_SECRET=
