+/** План подготовки: чтение, создание, сжатие, агент, достижения. */
+import { Hono } from "hono";
+import type { Env } from "../../env";
+import { ok, fail, requestId } from "../../lib/response";
+import { requireAuth, type AuthVariables } from "../../middleware/auth";
+import { createServiceClient } from "../../lib/supabase";
+import { logActivity } from "../../lib/activity";
+import { AGENT_PLAN_KIND, agentDay, buildAgentItems, isValidEventDate } from "../../lib/exam-agent";
+
+const studyPrep = new Hono<{ Bindings: Env; Variables: AuthVariables }>();
+import { UUID, isoToday, prepReadinessForEvents, buildPlanDays, isMissingTable, loadEvent, loadProgress, planPayload } from "./planning";
+
+// GET /study-prep/plan?event=<schedule_entry_id> — сохранённый план или предпросмотр.
+studyPrep.get("/plan", requireAuth, async (c) => {
+  const rid = requestId();
+  const db = c.get("supabase");
+  const user = c.get("user");
+  const eventId = String(c.req.query("event") || "").trim();
+  if (!UUID.test(eventId)) {
+    const { body, status } = fail("VALIDATION_ERROR", "Нужен параметр event (id события расписания)", 422, rid);
+    return c.json(body, status as 422);
+  }
+  try {
+    const event = await loadEvent(db, user.id, eventId);
+    if (!event) {
+      const { body, status } = fail("EVENT_NOT_FOUND", "Событие не найдено в расписании вашей группы", 404, rid);
+      return c.json(body, status as 404);
+    }
+    const { data: saved, error } = await db
+      .from("study_plans")
+      .select("id,schedule_entry_id,subject_slug,event_kind,event_date,days,topics,mastery_pct,status,generated_by,updated_at")
+      .eq("user_id", user.id)
+      .eq("schedule_entry_id", eventId)
+      .eq("status", "active")
+      .maybeSingle();
+    if (!error && saved) return c.json(ok(planPayload(saved, true), rid));
+
+    // Предпросмотр: правила без сохранения (в т.ч. пока миграция не применена).
+    const progress = await loadProgress(db, user.id);
+    // Кнопка «Готовиться» есть у любого события, поэтому план строится по темам
+    // предмета и для занятия: готовность в сводке остаётся только по аттестациям.
+    const readiness = await prepReadinessForEvents(db, [event], progress, { includeAllKinds: true });
+    const prep = readiness.get(eventId);
+    const topics = prep?.topics ?? [];
+    const mastery = prep?.mastery_pct ?? 0;
+    const days = buildPlanDays({
+      topics,
+      today: isoToday(),
+      eventDate: String(event.date),
+      subjectSlug: prep?.subject_slug ?? null,
+      readiness: mastery,
+    });
+    const preview = {
+      id: null,
+      schedule_entry_id: eventId,
+      subject_slug: prep?.subject_slug ?? null,
+      event_kind: String(event.event_kind || "colloquium"),
+      event_date: String(event.date),
+      days,
+      topics,
+      mastery_pct: mastery,
+      status: "active",
+      generated_by: "rules",
+    };
+    const notice = error && isMissingTable(error) ? "План пока не сохраняется: миграция study_plans не применена." : undefined;
+    return c.json(ok(planPayload(preview, false, notice), rid));
+  } catch (error) {
+    console.error("[study-prep:get]", error);
+    const { body, status } = fail("STUDY_PLAN_ERROR", "Не удалось загрузить план подготовки", 503, rid);
+    return c.json(body, status as 503);
+  }
+});
+
+// POST /study-prep/plan {schedule_entry_id} — создать или пересобрать план (идемпотентно).
+studyPrep.post("/plan", requireAuth, async (c) => {
+  const rid = requestId();
+  const db = c.get("supabase");
+  const user = c.get("user");
+  let payload: any;
+  try {
+    payload = await c.req.json();
+  } catch {
+    const { body, status } = fail("VALIDATION_ERROR", "Некорректный JSON", 400, rid);
+    return c.json(body, status as 400);
+  }
+  const eventId = String(payload?.schedule_entry_id || "").trim();
+  if (!UUID.test(eventId)) {
+    const { body, status } = fail("VALIDATION_ERROR", "Нужен schedule_entry_id", 422, rid);
+    return c.json(body, status as 422);
+  }
+  try {
+    const event = await loadEvent(db, user.id, eventId);
+    if (!event) {
+      const { body, status } = fail("EVENT_NOT_FOUND", "Событие не найдено в расписании вашей группы", 404, rid);
+      return c.json(body, status as 404);
+    }
+    const progress = await loadProgress(db, user.id);
+    // Кнопка «Готовиться» есть у любого события, поэтому план строится по темам
+    // предмета и для занятия: готовность в сводке остаётся только по аттестациям.
+    const readiness = await prepReadinessForEvents(db, [event], progress, { includeAllKinds: true });
+    const prep = readiness.get(eventId);
+    const topics = prep?.topics ?? [];
+    const mastery = prep?.mastery_pct ?? 0;
+    const days = buildPlanDays({
+      topics,
+      today: isoToday(),
+      eventDate: String(event.date),
+      subjectSlug: prep?.subject_slug ?? null,
+      readiness: mastery,
+    });
+    const { data: existing, error: existingError } = await db
+      .from("study_plans")
+      .select("id")
+      .eq("user_id", user.id)
+      .eq("schedule_entry_id", eventId)
+      .maybeSingle();
+    if (existingError) {
+      if (isMissingTable(existingError)) {
+        return c.json(ok(planPayload({
+          id: null, schedule_entry_id: eventId, subject_slug: prep?.subject_slug ?? null,
+          event_kind: String(event.event_kind || "colloquium"), event_date: String(event.date),
+          days, topics, mastery_pct: mastery, status: "active", generated_by: "rules",
+        }, false, "План пока не сохраняется: миграция study_plans не применена."), rid));
+      }
+      throw existingError;
+    }
+    const body = {
+      user_id: user.id,
+      schedule_entry_id: eventId,
+      subject_slug: prep?.subject_slug ?? null,
+      event_kind: String(event.event_kind || "colloquium"),
+      event_date: String(event.date),
+      days,
+      topics,
+      mastery_pct: mastery,
+      status: "active",
+      generated_by: "rules",
+      updated_at: new Date().toISOString(),
+    };
+    const result = existing?.id
+      ? await db.from("study_plans").update(body).eq("id", existing.id).eq("user_id", user.id)
+          .select("id,schedule_entry_id,subject_slug,event_kind,event_date,days,topics,mastery_pct,status,generated_by,updated_at").maybeSingle()
+      : await db.from("study_plans").insert(body)
+          .select("id,schedule_entry_id,subject_slug,event_kind,event_date,days,topics,mastery_pct,status,generated_by,updated_at").maybeSingle();
+    if (result.error) throw result.error;
+    return c.json(ok(planPayload(result.data, true), rid), existing?.id ? 200 : 201);
+  } catch (error) {
+    console.error("[study-prep:create]", error);
+    const { body, status } = fail("STUDY_PLAN_ERROR", "Не удалось собрать план подготовки", 503, rid);
+    return c.json(body, status as 503);
+  }
+});
+
+// PATCH /study-prep/plan/:id {day, index, done} — отметка шага.
+studyPrep.patch("/plan/:id", requireAuth, async (c) => {
+  const rid = requestId();
+  const db = c.get("supabase");
+  const user = c.get("user");
+  const planId = String(c.req.param("id") || "").trim();
+  if (!UUID.test(planId)) {
+    const { body, status } = fail("VALIDATION_ERROR", "Некорректный id плана", 422, rid);
+    return c.json(body, status as 422);
+  }
+  let payload: any;
+  try {
+    payload = await c.req.json();
+  } catch {
+    const { body, status } = fail("VALIDATION_ERROR", "Некорректный JSON", 400, rid);
+    return c.json(body, status as 400);
+  }
+  const day = String(payload?.day || "").trim();
+  const index = Number(payload?.index);
+  const done = payload?.done === true;
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(day) || !Number.isInteger(index) || index < 0) {
+    const { body, status } = fail("VALIDATION_ERROR", "Нужны day (yyyy-mm-dd) и index шага", 422, rid);
+    return c.json(body, status as 422);
+  }
+  try {
+    // Атомарная отметка шага: две вкладки не должны затирать галочки друг друга.
+    // Оптимистическая блокировка по updated_at — запись уходит, только если план
+    // не менялся с момента чтения; иначе перечитываем и применяем заново.
+    for (let attempt = 0; attempt < 3; attempt += 1) {
+      const { data: plan, error } = await db
+        .from("study_plans")
+        .select("id,days,status,updated_at")
+        .eq("id", planId)
+        .eq("user_id", user.id)
+        .maybeSingle();
+      if (error) throw error;
+      if (!plan) {
+        const { body, status } = fail("PLAN_NOT_FOUND", "План не найден", 404, rid);
+        return c.json(body, status as 404);
+      }
+      const days = Array.isArray(plan.days) ? plan.days : [];
+      const target = days.find((entry: any) => String(entry?.date || "") === day);
+      if (!target || !Array.isArray(target.items) || !target.items[index]) {
+        const { body, status } = fail("VALIDATION_ERROR", "Шаг плана не найден", 422, rid);
+        return c.json(body, status as 422);
+      }
+      target.items[index].done = done;
+      const everyDone = days.every((entry: any) =>
+        Array.isArray(entry?.items) ? entry.items.every((item: any) => item?.done === true) : true);
+      const { data: updated, error: updateError } = await db
+        .from("study_plans")
+        .update({ days, status: everyDone ? "completed" : "active", updated_at: new Date().toISOString() })
+        .eq("id", planId)
+        .eq("user_id", user.id)
+        // Условие по прочитанному updated_at: другой PATCH успел пройти — строка
+        // не обновится, перечитываем и переносим отметку на свежую версию.
+        .eq("updated_at", plan.updated_at)
+        .select("id,schedule_entry_id,subject_slug,event_kind,event_date,days,topics,mastery_pct,status,generated_by,updated_at")
+        .maybeSingle();
+      if (updateError) throw updateError;
+      if (updated) return c.json(ok(planPayload(updated, true), rid));
+    }
+    const { body, status } = fail("PLAN_CONFLICT", "План менялся параллельно — обновите страницу и повторите", 409, rid);
+    return c.json(body, status as 409);
+  } catch (error) {
+    console.error("[study-prep:patch]", error);
+    const { body, status } = fail("STUDY_PLAN_ERROR", "Не удалось обновить план", 503, rid);
+    return c.json(body, status as 503);
+  }
+});
+
+// POST /study-prep/plan/:id/compress — сжать повторения под дату события (Фаза 6).
+// Карточки предмета с due_at позже дня накануне события становятся доступны раньше.
+// Только сдвиг вперёд по времени (раньше), никогда не отложить: SRS-расписание
+// не должно ухудшаться.
+studyPrep.post("/plan/:id/compress", requireAuth, async (c) => {
+  const rid = requestId();
+  const db = c.get("supabase");
+  const user = c.get("user");
+  const planId = String(c.req.param("id") || "").trim();
+  if (!UUID.test(planId)) {
+    const { body, status } = fail("VALIDATION_ERROR", "Некорректный id плана", 422, rid);
+    return c.json(body, status as 422);
+  }
+  try {
+    const { data: plan, error } = await db
+      .from("study_plans")
+      .select("id,subject_slug,event_date,topics")
+      .eq("id", planId)
+      .eq("user_id", user.id)
+      .maybeSingle();
+    if (error) throw error;
+    if (!plan) {
+      const { body, status } = fail("PLAN_NOT_FOUND", "План не найден", 404, rid);
+      return c.json(body, status as 404);
+    }
+    const subjectSlug = plan.subject_slug ? String(plan.subject_slug) : "";
+    const topics = Array.isArray(plan.topics)
+      ? (plan.topics as any[]).map((topic) => String(topic?.title || "")).filter(Boolean).slice(0, 20)
+      : [];
+    if (!subjectSlug && !topics.length) {
+      const { body, status } = fail("VALIDATION_ERROR", "В плане нет предмета и тем — сжимать нечего", 422, rid);
+      return c.json(body, status as 422);
+    }
+    const target = new Date(Date.parse(String(plan.event_date) + "T00:00:00Z") - 86400000);
+    const targetIso = target.toISOString();
+    let query = db
+      .from("srs_cards")
+      .update({ due_at: targetIso, updated_at: new Date().toISOString() })
+      .eq("user_id", user.id)
+      .gt("due_at", targetIso);
+    query = subjectSlug ? query.eq("subject_slug", subjectSlug) : query.in("topic", topics);
+    const { data: moved, error: updateError } = await query.select("id");
+    if (updateError) throw updateError;
+    return c.json(ok({
+      moved: Array.isArray(moved) ? moved.length : 0,
+      target_due: targetIso,
+      event_date: plan.event_date,
+      scope: subjectSlug ? "subject" : "topics",
+    }, rid));
+  } catch (error) {
+    console.error("[study-prep:compress]", error);
+    const { body, status } = fail("STUDY_PLAN_ERROR", "Не удалось сжать повторения", 503, rid);
+    return c.json(body, status as 503);
+  }
+});
+
+// ─── Фаза 2.6: ночной агент к экзамену ──────────────────────────────────────
+
+/**
+ * План агента на дату экзамена: один активный на (пользователь, предмет, дата).
+ * Повторный запрос не плодит планы — он догружает недостающие разборы.
+ */
+async function ensureAgentPlan(
+  db: any,
+  userId: string,
+  subjectSlug: string,
+  eventDate: string,
+): Promise<{ id: string; user_id: string; subject_slug: string | null; event_date: string } | null> {
+  const { data: existing, error } = await db
+    .from("study_plans")
+    .select("id,user_id,subject_slug,event_date,status")
+    .eq("user_id", userId)
+    .eq("subject_slug", subjectSlug)
+    .eq("event_kind", AGENT_PLAN_KIND)
+    .eq("event_date", eventDate)
+    .eq("status", "active")
+    .maybeSingle();
+  if (error) throw error;
+  if (existing) return existing;
+  const { data, error: insertError } = await db
+    .from("study_plans")
+    .insert({
+      user_id: userId,
+      subject_slug: subjectSlug,
+      event_kind: AGENT_PLAN_KIND,
+      event_date: eventDate,
+      days: [],
+      topics: [],
+      generated_by: "rules",
+    })
+    .select("id,user_id,subject_slug,event_date")
+    .maybeSingle();
+  if (insertError) throw insertError;
+  return data;
+}
+
+// POST /agent — создать план агента и сразу собрать разборы на сегодня.
+studyPrep.post("/agent", requireAuth, async (c) => {
+  const rid = requestId();
+  const db = c.get("supabase");
+  const user = c.get("user");
+  let body: any = {};
+  try {
+    body = await c.req.json();
+  } catch {
+    const { body: errBody, status } = fail("VALIDATION_ERROR", "Некорректный JSON", 400, rid);
+    return c.json(errBody, status as 400);
+  }
+  const subjectSlug = String(body?.subject_slug || "").trim();
+  const eventDate = String(body?.event_date || "").trim();
+  if (!/^[a-z0-9_-]{2,60}$/i.test(subjectSlug)) {
+    const { body: errBody, status } = fail("VALIDATION_ERROR", "Некорректный предмет", 422, rid);
+    return c.json(errBody, status as 422);
+  }
+  if (!isValidEventDate(eventDate)) {
+    const { body: errBody, status } = fail("VALIDATION_ERROR", "Дата экзамена должна быть в пределах 180 дней от сегодня", 422, rid);
+    return c.json(errBody, status as 422);
+  }
+  try {
+    // В таблице бывают активные дубли с одним slug, поэтому maybeSingle() падал
+    // с «multiple rows» и агент отвечал «Предмет не найден». Берём любую строку.
+    const { data: subjectRows } = await db
+      .from("subjects")
+      .select("slug")
+      .eq("slug", subjectSlug)
+      .eq("is_active", true)
+      .limit(1);
+    if (!subjectRows?.length) {
+      const { body: errBody, status } = fail("SUBJECT_NOT_FOUND", "Предмет не найден", 404, rid);
+      return c.json(errBody, status as 404);
+    }
+    const plan = await ensureAgentPlan(db, user.id, subjectSlug, eventDate);
+    if (!plan) {
+      const { body: errBody, status } = fail("PLAN_NOT_CREATED", "Не удалось создать план агента", 503, rid);
+      return c.json(errBody, status as 503);
+    }
+    const service = createServiceClient(c.env);
+    if (!service) {
+      const { body: errBody, status } = fail("SERVICE_UNAVAILABLE", "Агент временно недоступен", 503, rid);
+      return c.json(errBody, status as 503);
+    }
+    const day = agentDay();
+    let added = 0;
+    try {
+      // Идемпотентность на день: повторный «Запустить» не добавляет вторую
+      // порцию разборов (иначе один день превращается в 16 вопросов).
+      const { count } = await service
+        .from("study_agent_items")
+        .select("id", { count: "exact", head: true })
+        .eq("plan_id", plan.id)
+        .eq("day", day);
+      if (!count) added = await buildAgentItems(service, { ...plan, user_id: user.id }, day);
+    } catch (buildError) {
+      console.warn("[study-prep:agent:build]", buildError instanceof Error ? buildError.message : "unavailable");
+    }
+    return c.json(ok({ plan, day, added }, rid));
+  } catch (error) {
+    console.error("[study-prep:agent:create]", error);
+    const { body: errBody, status } = fail("STUDY_AGENT_ERROR", "Не удалось запустить агента", 503, rid);
+    return c.json(errBody, status as 503);
+  }
+});
+
+// GET /agent — планы агента с разборами на сегодня и на завтра.
+studyPrep.get("/agent", requireAuth, async (c) => {
+  const rid = requestId();
+  const db = c.get("supabase");
+  const user = c.get("user");
+  const today = agentDay();
+  const tomorrow = agentDay(new Date(), 1);
+  try {
+    const { data: plans, error } = await db
+      .from("study_plans")
+      .select("id,subject_slug,event_date,status,created_at")
+      .eq("user_id", user.id)
+      .eq("event_kind", AGENT_PLAN_KIND)
+      .eq("status", "active")
+      .gte("event_date", today)
+      .order("event_date", { ascending: true })
+      .limit(20);
+    if (error) throw error;
+    if (!plans?.length) return c.json(ok({ plans: [], today, tomorrow, questions_per_day: 8 }, rid));
+
+    const ids = plans.map((plan: any) => String(plan.id));
+    const { data: items, error: itemsError } = await db
+      .from("study_agent_items")
+      .select("id,plan_id,day,question_text,answer,topic,done,position")
+      .eq("user_id", user.id)
+      .in("plan_id", ids)
+      .in("day", [today, tomorrow])
+      .order("day", { ascending: true })
+      .order("position", { ascending: true })
+      .limit(400);
+    if (itemsError) throw itemsError;
+
+    const shaped = plans.map((plan: any) => {
+      const ofPlan = (items || []).filter((item: any) => String(item.plan_id) === String(plan.id));
+      const bucket = (day: string) => {
+        const list = ofPlan.filter((item: any) => String(item.day) === day);
+        return { day, items: list, done: list.filter((item: any) => item.done).length, total: list.length };
+      };
+      const daysLeft = Math.max(
+        0,
+        Math.round((Date.parse(`${plan.event_date}T00:00:00Z`) - Date.parse(`${today}T00:00:00Z`)) / 86400000),
+      );
+      return { ...plan, days_left: daysLeft, today: bucket(today), tomorrow: bucket(tomorrow) };
+    });
+    return c.json(ok({ plans: shaped, today, tomorrow, questions_per_day: 8 }, rid));
+  } catch (error) {
+    console.error("[study-prep:agent:list]", error);
+    const missing = String((error as any)?.code || "") === "42P01" || String((error as any)?.code || "") === "PGRST205";
+    const { body: errBody, status } = fail(
+      missing ? "AGENT_NOT_MIGRATED" : "STUDY_AGENT_ERROR",
+      missing ? "Агент появится после применения миграции study_agent_items" : "Не удалось загрузить агента",
+      503,
+      rid,
+    );
+    return c.json(errBody, status as 503);
+  }
+});
+
+// POST /agent/report — прислать отчёт двойника в Telegram сейчас (тот же
+// текст, что уходит утренним cron). Удобно проверить связку и получить
+// разборы, не дожидаясь ночи.
+studyPrep.post("/agent/report", requireAuth, async (c) => {
+  const rid = requestId();
+  const db = c.get("supabase");
+  const user = c.get("user");
+  const day = agentDay();
+  try {
+    const { data: plans, error } = await db
+      .from("study_plans")
+      .select("id,user_id,subject_slug,event_date")
+      .eq("user_id", user.id)
+      .eq("event_kind", AGENT_PLAN_KIND)
+      .eq("status", "active")
+      .gte("event_date", day)
+      .limit(10);
+    if (error) throw error;
+    if (!plans?.length) {
+      const { body: errBody, status } = fail("NO_AGENT_PLAN", "Сначала запустите агента — планов нет", 404, rid);
+      return c.json(errBody, status as 404);
+    }
+    const { notifyPlanReport } = await import("../../jobs/exam-agent");
+    let sent = 0;
+    for (const plan of plans) {
+      const { count } = await db
+        .from("study_agent_items")
+        .select("id", { count: "exact", head: true })
+        .eq("plan_id", plan.id)
+        .eq("day", day);
+      if (!count) await buildAgentItems(db, plan as any, day);
+      if (await notifyPlanReport(c.env, db, plan as any, day)) sent += 1;
+    }
+    if (!sent) {
+      const botReady = Boolean(String(c.env.TELEGRAM_BOT_TOKEN || "").trim());
+      const { body: errBody, status } = fail(
+        botReady ? "TELEGRAM_NOT_LINKED" : "TELEGRAM_BOT_NOT_CONFIGURED",
+        botReady
+          ? "Отчёт некому отправить: привяжите Telegram в настройках бота"
+          : "Telegram-бот не настроен на сервере: не задан TELEGRAM_BOT_TOKEN",
+        422,
+        rid,
+      );
+      return c.json(errBody, status as 422);
+    }
+    return c.json(ok({ sent, day }, rid));
+  } catch (error) {
+    console.error("[study-prep:agent:report]", error);
+    const { body: errBody, status } = fail("STUDY_AGENT_ERROR", "Не удалось отправить отчёт", 503, rid);
+    return c.json(errBody, status as 503);
+  }
+});
+
+/**
+ * Значки (коллекция достижений). Считаются из activity_events и очереди SRS —
+ * новых таблиц нет, значок нельзя «потерять» и нельзя накрутить клиентом.
+ * Пороги намеренно низкие: первый шаг важнее рекорда.
+ */
+studyPrep.get("/achievements", requireAuth, async (c) => {
+  const rid = requestId();
+  const db = c.get("supabase");
+  const user = c.get("user");
+  try {
+    const { data, error } = await db
+      .from("activity_events")
+      .select("kind,created_at")
+      .eq("user_id", user.id)
+      .limit(5000);
+    if (error) throw error;
+    const rows = data || [];
+    const count = (kinds: string[]) => rows.filter((row: any) => kinds.includes(String(row.kind || ""))).length;
+    const days = new Set<string>();
+    for (const row of rows) {
+      const day = String((row as any).created_at || "").slice(0, 10);
+      if (day) days.add(day);
+    }
+    const tests = count(["test_finished"]);
+    const reviews = count(["srs_review"]);
+    const lectures = count(["lecture_opened"]);
+    const cloze = count(["cloze_completed"]);
+    const tutor = count(["tutor_message"]);
+    const activeDays = days.size;
+
+    const badges = [
+      { id: "first_test", title: "Первый тест", hint: "пройти один тест", goal: 1, value: tests },
+      { id: "ten_tests", title: "Десятка", hint: "10 тестов", goal: 10, value: tests },
+      { id: "first_card", title: "Первое повторение", hint: "повторить карточку", goal: 1, value: reviews },
+      { id: "hundred_cards", title: "Сотка карточек", hint: "100 повторений", goal: 100, value: reviews },
+      { id: "first_lecture", title: "Первая лекция", hint: "открыть лекцию", goal: 1, value: lectures },
+      { id: "cloze_5", title: "Конспект с пропусками", hint: "5 cloze-конспектов", goal: 5, value: cloze },
+      { id: "tutor_10", title: "Свой вопрос", hint: "10 вопросов тьютору", goal: 10, value: tutor },
+      { id: "week_streak", title: "Неделя без пропусков", hint: "7 активных дней", goal: 7, value: activeDays },
+      { id: "month_streak", title: "Месяц учёбы", hint: "30 активных дней", goal: 30, value: activeDays },
+    ].map((badge) => ({
+      ...badge,
+      value: Math.min(badge.value, badge.goal),
+      earned: badge.value >= badge.goal,
+    }));
+
+    return c.json(ok({ badges, earned: badges.filter((b) => b.earned).length, total: badges.length }, rid));
+  } catch (error) {
+    console.error("[study-prep:achievements]", error);
+    const { body: errBody, status } = fail("ACHIEVEMENTS_ERROR", "Не удалось собрать значки", 503, rid);
+    return c.json(errBody, status as 503);
+  }
+});
+
+/**
+ * Цели дня: три конкретных дела вместо абстрактного «позанимайся».
+ * Считаются из реальных данных — очередь SRS и события за сегодня, — поэтому
+ * отдельная таблица квестов не нужна и цели не расходятся с фактами.
+ */
+/** Сундук дня: +20 XP за все три цели. Награда — обычное событие
+ * `quest_chest`, поэтому отдельная таблица наград не нужна, а повторная
+ * попытка забрать сундук в тот же день отсекается по наличию события. */
+
+export default studyPrep;
