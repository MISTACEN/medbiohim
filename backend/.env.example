# Copy to .env on SpaceWeb — never commit real values

APP_ENV=development
APP_DEBUG=true

# Comma-separated frontend origins, or * for demo
CORS_ORIGINS=http://localhost:3000,https://medbiohim.vercel.app

# Supabase (server-only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# Optional direct Postgres
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=

# Backblaze B2 (Phase D)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=medbiohim-files
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
