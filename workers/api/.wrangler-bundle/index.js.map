 | 273 | 1 |\n| 38 | 3 | 97 | 4 | 156 | 4 | 215 | 5 | 274 | 2 |\n| 39 | 5 | 98 | 3 | 157 | 3 | 216 | 2 | 275 | 3 |\n| 40 | 3 | 99 | 4 | 158 | 4 | 217 | 1 | 276 | 2 |\n| 41 | 5 | 100 | 4 | 159 | 1 | 218 | 5 | 277 | 1 |\n| 42 | 1 | 101 | 1 | 160 | 1 | 219 | 5 | 278 | 5 |\n| 43 | 2 | 102 | 2 | 161 | 2 | 220 | 4 | 279 | 1 |\n| 44 | 4 | 103 | 2 | 162 | 3 | 221 | 2 | 280 | 1 |\n| 45 | 3 | 104 | 3 | 163 | 3 | 222 | 4 | 281 | 5 |\n| 46 | 5 | 105 | 2 | 164 | 3 | 223 | 4 | 282 | 2 |\n| 47 | 4 | 106 | 5 | 165 | 3 | 224 | 4 | 283 | 4 |\n| 48 | 4 | 107 | 3 | 166 | 2 | 225 | 5 | 284 | 1 |\n| 49 | 3 | 108 | 4 | 167 | 3 | 226 | 5 | 285 | 2 |\n| 50 | 3 | 109 | 5 | 168 | 4 | 227 | 4 | 286 | 4 |\n| 51 | 2 | 110 | 2 | 169 | 5 | 228 | 3 | 287 | 1 |\n| 52 | 5 | 111 | 5 | 170 | 4 | 229 | 4 | 288 | 4 |\n| 53 | 4 | 112 | 2 | 171 | 4 | 230 | 2 | 289 | 3 |\n| 54 | 3 | 113 | 4 | 172 | 3 | 231 | 2 | 290 | 3 |\n| 55 | 3 | 114 | 5 | 173 | 4 | 232 | 2 | 291 | 1+5 |\n| 56 | 3 | 115 | 4 | 174 | 1 | 233 | 3 | 292 | 3 |\n| 57 | 1 | 116 | 2 | 175 | 1 | 234 | 1 | 293 | 2 |\n| 58 | 1 | 117 | 2 | 176 | 2 | 235 | 4 | 294 | 2 |\n| 59 | 3 | 118 | 1 | 177 | 2 | 236 | 4 | | |\n\n---"
