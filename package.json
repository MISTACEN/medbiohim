{
  "name": "medbiohim-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "predeploy:audit": "node scripts/predeploy-audit.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:api-failover": "node --test test/api-failover.test.mjs",
    "test:physiology": "node --test test/physiology-content.test.mjs",
    "test:histology": "node --test test/histology-content.test.mjs",
    "test:overrides": "python -m unittest tools/histology/test_build_content_overrides.py",
    "test:preparations": "node --test test/preparations-bonus.test.mjs",
    "test:preparations:images": "node --test test/preparations-bonus-images.test.mjs",
    "preparations:photos": "node tools/preparations/process_bonus_photos.mjs",
    "test:chemistry": "node --test test/chemistry-part1.test.mjs",
    "chem:import-xlsx": "node tools/chem/build_import_xlsx.mjs",
    "test:chem-xlsx": "node --test test/chemistry-import-xlsx.test.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:e2e": "playwright test",
    "test:e2e:supabase": "node scripts/e2e-live-supabase.mjs",
    "test:e2e:api": "node scripts/e2e-live-api.mjs",
    "test:e2e:study": "node scripts/e2e-live-study.mjs",
    "test:e2e:agent": "node scripts/e2e-live-agent.mjs",
    "test:e2e:pages": "node scripts/e2e-live-pages.mjs",
    "dev:clean": "node scripts/dev-clean.mjs",
    "stitch:install": "node scripts/stitch/install.mjs",
    "stitch:login": "node scripts/stitch/login.mjs",
    "stitch:check": "node scripts/stitch/check.mjs",
    "stitch:tools": "node scripts/stitch/mcp.mjs tools"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pdfjs-dist": "^4.10.38",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "unpdf": "2.1.0",
    "xlsx": "npm:@keep-lts/xlsx@^0.18.6"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
