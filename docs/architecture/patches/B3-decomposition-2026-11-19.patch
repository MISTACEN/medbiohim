+  }, [detail, questionPhotos]);
+
+  return {
+    user,
+    dialog,
+    loggedIn,
+    staff,
+    settings,
+    subjects,
+    items,
+    loading,
+    note,
+    setNote,
+    error,
+    setError,
+    tab,
+    setTab,
+    query,
+    setQuery,
+    subjectFilter,
+    setSubjectFilter,
+    kindFilter,
+    setKindFilter,
+    composer,
+    setComposer,
+    drafts,
+    setDrafts,
+    section,
+    setSection,
+    uploading,
+    form,
+    setForm,
+    suggestion,
+    warning,
+    busy,
+    detail,
+    setDetail,
+    versions,
+    edit,
+    setEdit,
+    reportReason,
+    setReportReason,
+    inputRef,
+    load,
+    addFiles,
+    submit,
+    openDetail,
+    saveEdit,
+    toggleHidden,
+    removeItem,
+    restore,
+    report,
+    subjectName,
+    questionPhotos,
+    pairedPhotoIds,
+  };
+}
