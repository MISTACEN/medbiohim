# MEDBIOHIM — Vercel Environment Variables
# Import in Vercel or copy one-by-one (Production + Preview)

# Browser API is intentionally same-origin; Next.js proxies /api/v1 through the Vercel deployment.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://gnobvyjywtqbdfeejxmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY>
NEXT_PUBLIC_APP_NAME=Медбиохим

# Server-only proxy target for Vercel. Current SpaceWeb test endpoint is HTTP; use the API root, not /public/api/v1.
# SPACEWEB_API_ORIGIN=http://YOUR-SPACEWEB-DOMAIN/api/v1
