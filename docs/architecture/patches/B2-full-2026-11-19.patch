@@ -0,0 +1,94 @@
+import { resolveSubjectSlug } from "@/lib/subjectSlug";
+
+export type SubjectOption = {
+  id: string;
+  slug: string;
+  label: string;
+};
+
+export const PAGE_SIZE = 30;
+export const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+export const MAIN_SUBJECT_ORDER = ["histology", "physiology", "organic_chemistry"];
+
+export const KINDS = [
+  { value: "", label: "Все типы" },
+  { value: "mcq", label: "Тесты" },
+  { value: "open", label: "Открытые" },
+  { value: "theory", label: "Теория" },
+];
+
+export function plural(n: number, one: string, few: string, many: string) {
+  const value = Math.abs(n) % 100;
+  const last = value % 10;
+  if (value > 10 && value < 20) return many;
+  if (last > 1 && last < 5) return few;
+  if (last === 1) return one;
+  return many;
+}
+
+export function subjectRank(slug: string) {
+  const canonical = resolveSubjectSlug(slug);
+  const index = MAIN_SUBJECT_ORDER.indexOf(canonical);
+  return index === -1 ? 99 : index;
+}
+
+export function optionText(option: any) {
+  return typeof option === "string" ? option : String(option?.label ?? "");
+}
+
+export function optionKey(option: any, index: number) {
+  if (typeof option === "string") return String.fromCharCode(65 + index);
+  return option?.key != null && String(option.key).trim() ? String(option.key) : String.fromCharCode(65 + index);
+}
+
+export function answerPreview(value: any) {
+  const answer = String(value ?? "").trim();
+  if (!answer || /^\d{1,2}$/.test(answer)) return "";
+  return answer;
+}
+
+export function optionIsCorrect(option: any) {
+  return typeof option !== "string" && option?.correct === true;
+}
+
+export function isChoiceQuestion(question: any) {
+  const type = String(question?.type || "").trim().toLowerCase();
+  const options = Array.isArray(question?.options) ? question.options : [];
+  if (["open", "text", "short_answer", "short-answer", "theory"].includes(type)) return false;
+  if (["mc", "mcq", "single", "single_choice", "single-choice", "multiple_choice", "multiple-choice"].includes(type)) {
+    return options.length > 0;
+  }
+  // Unknown types: a single option is usually a placeholder such as
+  // "(открытый/соответствие)", not a real answer choice.
+  return options.length > 1;
+}
+
+export function officialAnswerText(question: any) {
+  const answer = String(question?.answer || "").trim();
+  if (!answer) return "Эталон пока пуст";
+  if (!isChoiceQuestion(question) && /^\d{1,2}$/.test(answer)) return `См. ключ (${answer})`;
+  return answer;
+}
+
+export function correctOptionIndexes(question: any) {
+  const options = Array.isArray(question?.options) ? question.options : [];
+  if (!options.length) return [];
+  const explicit = options.flatMap((option: any, index: number) => (optionIsCorrect(option) ? [index] : []));
+  if (explicit.length) return explicit;
+  if (typeof question?.correct === "number" && question.correct >= 0 && question.correct < options.length) {
+    return [question.correct];
+  }
+  return [];
+}
+
+export function referenceText(question: any) {
+  const display = String(question?.answer_display || "").trim();
+  if (display) return display;
+  const indexes = correctOptionIndexes(question);
+  if (indexes.length) {
+    return indexes
+      .map((index: number) => `${optionKey(question.options[index], index)}) ${optionText(question.options[index])}`)
+      .join("; ");
+  }
+  return officialAnswerText(question);
+}
diff --git a/src/components/practice/usePracticeData.ts b/src/components/practice/usePracticeData.ts
new file mode 100644
index 00000000..729e5529
--- /dev/null
+++ b/src/components/practice/usePracticeData.ts
@@ -0,0 +1,298 @@
+"use client";
+
+import { useEffect, useMemo, useRef, useState } from "react";
+import { useSearchParams } from "next/navigation";
+import {
+  getQuestion,
+  hasToken,
+  listFavorites,
+  listNotes,
+  listQuestions,
+  listQuestionSubjects,
+  toggleFavorite,
+  upsertNote,
+  type BankQuestion,
+} from "@/lib/api";
+import { useAuth } from "@/components/auth/AuthProvider";
+import { resolveSubjectSlug, subjectDisplayName } from "@/lib/subjectSlug";
+import { useApiRequest } from "@/hooks/useApiRequest";
+
+import { KINDS, PAGE_SIZE, UUID, subjectRank, type SubjectOption } from "./model";
+
+/**
+ * Данные и действия страницы «База вопросов».
+ *
+ * Состояние фильтров, загрузка предметов/списка/счётчиков и работа с
+ * избранным и заметками живут здесь, а разметка — в компонентах списка,
+ * фильтров и карточки вопроса.
+ */
+export function usePracticeData() {
+  const searchParams = useSearchParams();
+  const { user, loading: authLoading } = useAuth();
+  const [query, setQuery] = useState("");
+  const [debouncedQuery, setDebouncedQuery] = useState("");
+  const [subjectId, setSubjectId] = useState("");
+  const [subjectSlug, setSubjectSlug] = useState("");
+  const [kind, setKind] = useState("");
+  const [selected, setSelected] = useState<BankQuestion | null>(null);
+  const [selectedLoading, setSelectedLoading] = useState(false);
+  const [showAnswer, setShowAnswer] = useState(true);
+  const [draft, setDraft] = useState("");
+  const [favoriteIds, setFavoriteIds] = useState<Set<string>>(new Set());
+  const [savedNote, setSavedNote] = useState("");
+  const [noteSaving, setNoteSaving] = useState(false);
+  const [page, setPage] = useState(0);
+  const [filtersReady, setFiltersReady] = useState(false);
+  const [actionError, setActionError] = useState<string | null>(null);
+  const [savedMessage, setSavedMessage] = useState<string | null>(null);
+  const detailRef = useRef<HTMLDivElement | null>(null);
+  const listRef = useRef<HTMLDivElement | null>(null);
+  const openSequence = useRef(0);
+
+  // Older subject pages link with `subject=<uuid>`. Keep that deep link
+  // contract while also accepting the explicit subject_id/subject_slug form.
+  const legacySubject = searchParams.get("subject") || "";
+  const initialId = searchParams.get("subject_id") || (UUID.test(legacySubject) ? legacySubject : "");
+  const initialSlug = searchParams.get("subject_slug") || (!initialId ? legacySubject : "");
+  useEffect(() => {
+    if (initialId) setSubjectId(initialId);
+    if (initialSlug) setSubjectSlug(resolveSubjectSlug(initialSlug));
+    setFiltersReady(true);
+  }, [initialId, initialSlug]);
+
+  const { data: subjectsLoad, loading: subjectsLoading } = useApiRequest<{ subjects: SubjectOption[]; error: string | null }>(async () => {
+    if (!hasToken()) return { subjects: [], error: null };
+    try {
+      const result: any = await listQuestionSubjects();
+      if (!result.ok) {
+        return { subjects: [], error: result.error?.message || "Не удалось загрузить предметы." };
+      }
+      const map = new Map<string, SubjectOption>();
+      for (const raw of result.data?.items || []) {
+        const id = String(raw.subject_id || "");
+        const slug = resolveSubjectSlug(raw.subject_slug, raw.subject);
+        const key = id || slug;
+        if (!key) continue;
+        map.set(key, { id, slug, label: subjectDisplayName(slug, raw.subject) });
+      }
+      const next = Array.from(map.values()).sort((a, b) => {
+        const rank = subjectRank(a.slug) - subjectRank(b.slug);
+        return rank !== 0 ? rank : a.label.localeCompare(b.label, "ru");
+      });
+      return { subjects: next, error: null };
+    } catch {
+      return { subjects: [], error: "Не удалось загрузить предметы." };
+    }
+  }, [user?.id], { enabled: !authLoading });
+
+  const subjects = useMemo(() => subjectsLoad?.subjects ?? [], [subjectsLoad]);
+  const subjectsError = subjectsLoad?.error ?? null;
+
+  const { data: countsLoad } = useApiRequest<{ all: number | null; counts: Record<string, number> }>(async () => {
+    if (!hasToken() || !subjects.length) return { all: null, counts: {} };
+    try {
+      const [allResult, ...rows]: any[] = await Promise.all([
+        listQuestions({ limit: 1, include_answer: 1 }),
+        ...subjects.map((subject) => listQuestions({
+          subject_id: subject.id || undefined,
+          subject_slug: subject.id ? undefined : (subject.slug || undefined),
+          limit: 1,
+          include_answer: 1,
+        }).then((result: any) => [
+          subject.id || subject.slug,
+          result.ok ? Number(result.data?.total || 0) : 0,
+        ] as const)),
+      ]);
+      return {
+        all: allResult?.ok ? Number(allResult.data?.total || 0) : null,
+        counts: Object.fromEntries(rows),
+      };
+    } catch {
+      return { all: null, counts: {} };
+    }
+  }, [subjects, user?.id], { enabled: !authLoading });
+
+  const allQuestionsTotal = countsLoad?.all ?? null;
+  const subjectCounts = countsLoad?.counts ?? {};
+
+  const { data: fetchedFavoriteIds } = useApiRequest<Set<string>>(async () => {
+    if (!hasToken()) return new Set<string>();
+    const result: any = await listFavorites();
+    if (!result.ok) return new Set<string>();
+    return new Set(
+      (result.data?.items || [])
+        .filter((item: any) => item.target_type === "question")
+        .map((item: any) => String(item.target_id)),
+    );
+  }, [user?.id], { enabled: !authLoading });
+
+  useEffect(() => {
+    if (fetchedFavoriteIds) setFavoriteIds(fetchedFavoriteIds);
+  }, [fetchedFavoriteIds]);
+
+  useEffect(() => {
+    const timer = window.setTimeout(() => setDebouncedQuery(query.trim()), 250);
+    return () => window.clearTimeout(timer);
+  }, [query]);
+
+  const { data: listLoad, loading, reload: reloadList } = useApiRequest<{
+    items: BankQuestion[];
+    total: number;
+    error: string | null;
+  }>(async () => {
+    if (!hasToken()) return { items: [], total: 0, error: null };
+    try {
+      const result: any = await listQuestions({
+        subject_id: subjectId || undefined,
+        subject_slug: subjectId ? undefined : (subjectSlug || undefined),
+        kind: kind || undefined,
+        q: debouncedQuery || undefined,
+        limit: PAGE_SIZE,
+        offset: page * PAGE_SIZE,
+        include_answer: 1,
+      });
+      if (!result.ok) {
+        return { items: [], total: 0, error: result.error?.message || "Не удалось загрузить вопросы." };
+      }
+      return { items: result.data?.items || [], total: Number(result.data?.total || 0), error: null };
+    } catch {
+      return { items: [], total: 0, error: "Не удалось загрузить вопросы." };
+    }
+  }, [filtersReady, subjectId, subjectSlug, kind, debouncedQuery, page, user?.id], { enabled: filtersReady && !authLoading });
+
+  const items = listLoad?.items ?? [];
+  const total = listLoad?.total ?? 0;
+  const queryError = listLoad?.error ?? null;
+
+  useEffect(() => {
+    // A question from the previous filter should not stay open when the
+    // subject/type/search changes. Bumping the sequence also cancels an
+    // in-flight detail request for that question.
+    openSequence.current += 1;
+    setPage(0);
+    setSelected(null);
+    setSelectedLoading(false);
+  }, [subjectId, subjectSlug, kind, debouncedQuery]);
+
+  const subjectsById = useMemo(() => {
+    const map = new Map<string, string>();
+    for (const subject of subjects) {
+      if (subject.id) map.set(subject.id, subject.label);
+    }
+    return map;
+  }, [subjects]);
+
+  const activeSubject = subjects.find((subject) => (
+    subjectId ? subject.id === subjectId : subjectSlug ? subject.slug === subjectSlug : false
+  )) || null;
+  const activeSubjectLabel = activeSubject?.label
+    || (subjectSlug ? subjectDisplayName(subjectSlug) : subjectId ? "Выбранный предмет" : "Все предметы");
+  const activeKind = KINDS.find((item) => item.value === kind) || KINDS[0];
+  const hasFilters = Boolean(subjectId || subjectSlug || kind || debouncedQuery);
+  const subjectTotal = Object.values(subjectCounts).reduce((sum, value) => sum + value, 0);
+
+  function selectSubject(subject: SubjectOption | null) {
+    setSubjectId(subject?.id || "");
+    setSubjectSlug(subject?.slug || "");
+    setPage(0);
+  }
+
+  function resetFilters() {
+    setSubjectId("");
+    setSubjectSlug("");
+    setKind("");
+    setQuery("");
+    setDebouncedQuery("");
+    setPage(0);
+  }
+
+  function scrollDetailIntoView() {
+    if (typeof window !== "undefined" && window.matchMedia("(max-width: 1023px)").matches) {
+      window.setTimeout(() => detailRef.current?.scrollIntoView({ behavior: "smooth", block: "start" }), 40);
+    }
+  }
+
+  async function openQuestion(id: string) {
+    const sequence = ++openSequence.current;
+    setSelectedLoading(true);
+    setShowAnswer(true);
+    setDraft("");
+    setActionError(null);
+    setSavedMessage(null);
+    scrollDetailIntoView();
+    try {
+      const [questionResult, notesResult]: any[] = await Promise.all([getQuestion(id), listNotes()]);
+      if (sequence !== openSequence.current) return;
+      if (!questionResult.ok) {
+        setActionError(questionResult.error?.message || "Не удалось открыть вопрос.");
+        setSelectedLoading(false);
+        return;
+      }
+      setSelected(questionResult.data?.question || null);
+      const mine = notesResult.ok
+        ? (notesResult.data?.items || []).find(
+            (item: any) => item.target_type === "question" && String(item.target_id) === String(id),
+          )
+        : null;
+      setSavedNote(String(mine?.text || ""));
+      setSelectedLoading(false);
+      scrollDetailIntoView();
+    } catch {
+      if (sequence !== openSequence.current) return;
+      setActionError("Не удалось открыть вопрос.");
+      setSelectedLoading(false);
+    }
+  }
+
+  async function toggleSelectedFavorite() {
+    if (!selected) return;
+    const result: any = await toggleFavorite("question", selected.id);
+    if (!result.ok) {
+      setActionError(result.error?.message || "Не удалось изменить избранное.");
+      return;
+    }
+    setFavoriteIds((previous) => {
+      const next = new Set(previous);
+      if (result.data?.favorited) next.add(String(selected.id));
+      else next.delete(String(selected.id));
+      return next;
+    });
+  }
+
+  async function saveSelectedNote() {
+    if (!selected) return;
+    setNoteSaving(true);
+    setActionError(null);
+    setSavedMessage(null);
+    const result: any = await upsertNote("question", selected.id, savedNote);
+    setNoteSaving(false);
+    if (!result.ok) {
+      setActionError(result.error?.message || "Не удалось сохранить заметку.");
+      return;
+    }
+    setSavedMessage("Заметка сохранена");
+  }
+
+  return {
+    authLoading,
+    query, setQuery,
+    debouncedQuery,
+    subjectId, subjectSlug,
+    kind, setKind,
+    subjects, subjectsLoading, subjectsError,
+    subjectCounts, allQuestionsTotal, subjectTotal,
+    subjectsById,
+    items, total, loading, reloadList, queryError,
+    page, setPage,
+    hasFilters, activeSubjectLabel, activeKind,
+    selectSubject, resetFilters,
+    selected, selectedLoading, openQuestion,
+    showAnswer, setShowAnswer,
+    draft, setDraft,
+    favoriteIds, toggleSelectedFavorite,
+    savedNote, setSavedNote, noteSaving, savedMessage,
+    saveSelectedNote,
+    actionError,
+    detailRef, listRef,
+  };
+}
diff --git a/src/components/schedule/DayView.tsx b/src/components/schedule/DayView.tsx
new file mode 100644
index 00000000..a1667ef4
--- /dev/null
+++ b/src/components/schedule/DayView.tsx
@@ -0,0 +1,70 @@
+"use client";
+
+/** День: pill-кнопки дней недели и список занятий выбранного дня. */
+import { CalendarDays, ClipboardList } from "lucide-react";
+import { EmptyState } from "@/components/ui/EmptyState";
+import { importantEventKind } from "@/components/schedule/ScheduleCard";
+import { EVENT_KIND_LABELS } from "@/components/schedule/model";
+import { TYPE_LABELS, attendanceLabel, dayDateRu, startOfWeekYmd, subjectColor, weekdayShortRu } from "@/components/schedule/utils";
+import type { ScheduleController } from "@/components/schedule/useSchedulePage";
+
+export function DayView({ schedule }: { schedule: ScheduleController }) {
+  const {
+    days,
+    today,
+    currentDayItems,
+    setSelectedDay,
+    setWeekStart,
+    setView,
+    openLesson,
+    homeworkByEntry,
+    dayScrollRef,
+    rememberDayScroll,
+  } = schedule;
+
+  return (
+    <div className="space-y-3">
+      <div className="schedule-day-picker" ref={dayScrollRef} onScroll={rememberDayScroll}>
+        {days.map(({ key }) => (
+          <button key={key} type="button" className={key === today ? "schedule-day-pill schedule-day-pill-active" : "schedule-day-pill"} onClick={() => { setSelectedDay(key); setWeekStart(startOfWeekYmd(key)); setView("day"); }}>
+            <span>{weekdayShortRu(key)}</span><b>{dayDateRu(key)}</b>
+          </button>
+        ))}
+      </div>
+      <div className="card divide-y overflow-hidden p-0">
+        {currentDayItems.length === 0 ? (
+          <EmptyState
+            compact
+            icon={CalendarDays}
+            title="На сегодня занятий нет"
+            description="Выберите другой день pill-кнопками выше или проверьте «Неделю» и «Месяц»."
+          />
+        ) : currentDayItems.map((item) => (
+          <button key={item.id || item.start_time} type="button" className="flex w-full gap-4 p-4 text-left hover:bg-black/5" onClick={() => openLesson(item)}>
+            <div className="w-24 shrink-0 text-sm font-semibold" style={{ color: "var(--primary)" }}>{item.start_time.slice(0, 5)}–{item.end_time.slice(0, 5)}</div>
+            <div className="min-w-0">
+              <div className="flex flex-wrap items-center gap-2">
+                <b className="font-bold" style={{ borderLeft: `3px solid ${subjectColor(item)}`, paddingLeft: 8 }}>{item.subject_name || "Занятие"}</b>
+                {importantEventKind((item as { event_kind?: unknown }).event_kind) && (
+                  <span className="rounded-full bg-[var(--status-warn-bg)] px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-[var(--status-warn-fg)]">
+                    {EVENT_KIND_LABELS[importantEventKind((item as { event_kind?: unknown }).event_kind) as string]}
+                  </span>
+                )}
+              </div>
+              <div className="text-xs" style={{ color: "var(--muted)" }}>{item.is_makeup ? "ОТРАБОТКА" : TYPE_LABELS[item.type || ""] || item.type} · {attendanceLabel(item.attendance_status) || "отметьте посещение"}</div>
+              {(homeworkByEntry[String(item.id ?? "")] || []).length > 0 && (
+                <div className="mt-1.5 flex flex-wrap gap-1.5">
+                  {(homeworkByEntry[String(item.id ?? "")] || []).map((hw: any) => (
+                    <span key={String(hw.id)} className="inline-flex items-center gap-1 rounded-full bg-[var(--primary-soft)] px-2 py-0.5 text-[11px] font-semibold text-[var(--primary)]" title={String(hw.description || hw.title || "")}>
+                      <ClipboardList className="h-3 w-3" /> ДЗ: {String(hw.title || "")}{hw.my_status === "done" ? " ✓" : ""}
+                    </span>
+                  ))}
+                </div>
+              )}
+            </div>
+          </button>
+        ))}
+      </div>
+    </div>
+  );
+}
diff --git a/src/components/schedule/HomeworkPlanner.tsx b/src/components/schedule/HomeworkPlanner.tsx
new file mode 100644
index 00000000..880b7c03
--- /dev/null
+++ b/src/components/schedule/HomeworkPlanner.tsx
@@ -0,0 +1,111 @@
+"use client";
+
+/**
+ * Планировщик заданий: свёрнутый список всех ДЗ семестра с поиском, фильтрами
+ * и переносом срока. Разметка перенесена из `src/app/schedule/page.tsx`.
+ */
+import { CalendarClock, CheckCircle2, ClipboardList, Loader2, Search } from "lucide-react";
+import { EmptyState } from "@/components/ui/EmptyState";
+import { addDaysYmd, shortDateRu, subjectColor } from "@/components/schedule/utils";
+import type { ScheduleController } from "@/components/schedule/useSchedulePage";
+
+export function HomeworkPlanner({ schedule }: { schedule: ScheduleController }) {
+  const {
+    loading,
+    homeworks,
+    filteredHomeworks,
+    hwSearch,
+    setHwSearch,
+    hwSubject,
+    setHwSubject,
+    hwSubjects,
+    hwStatus,
+    setHwStatus,
+    homeworkBusy,
+    homeworkStatus,
+    homeworkStatusLabel,
+    homeworkEditable,
+    toggleHomework,
+    rescheduleHomework,
+    now,
+  } = schedule;
+
+  if (loading || homeworks.length === 0) return null;
+
+  return (
+    <details className="rounded-2xl border p-4" aria-label="Планировщик заданий">
+      <summary className="flex cursor-pointer flex-wrap items-center justify-between gap-2">
+        <div>
+          <b>Планировщик заданий</b>
+          <p className="text-xs opacity-60">Все ДЗ семестра: поиск, фильтры по предмету и статусу, перенос сроков.</p>
+        </div>
+        <span className="rounded-full px-2 py-1 text-xs font-bold">{filteredHomeworks.length} / {homeworks.length}</span>
+      </summary>
+      <div className="mb-3 mt-3 flex flex-wrap items-center gap-2">
+        <label className="relative">
+          <Search className="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 opacity-50" />
+          <input
+            value={hwSearch}
+            onChange={(e) => setHwSearch(e.target.value)}
+            placeholder="Поиск по заданиям…"
+            className="w-56 rounded-lg border border-[var(--border)] bg-[var(--card)] py-1.5 pl-8 pr-2 text-sm"
+          />
+        </label>
+        <select
+          value={hwSubject}
+          onChange={(e) => setHwSubject(e.target.value)}
+          className="rounded-lg border border-[var(--border)] bg-[var(--card)] px-2 py-1.5 text-sm"
+          aria-label="Фильтр по предмету"
+        >
+          <option value="">Все предметы</option>
+          {hwSubjects.map((s) => <option key={s} value={s}>{s}</option>)}
+        </select>
+        <div className="schedule-tabs">
+          {([["all", "Все"], ["active", "Активные"], ["overdue", "Просрочено"], ["done", "Готово"]] as const).map(([id, label]) => (
+            <button key={id} type="button" onClick={() => setHwStatus(id)} className={hwStatus === id ? "schedule-tab schedule-tab-active" : "schedule-tab"}>{label}</button>
+          ))}
+        </div>
+      </div>
+      {filteredHomeworks.length === 0 ? (
+        <EmptyState compact icon={ClipboardList} title="Заданий по фильтру нет" description="Измените поиск или фильтры — либо все задания в этом статусе закрыты." />
+      ) : (
+        <ul className="space-y-2">
+          {filteredHomeworks.map((h: any) => {
+            const hs = homeworkStatus(h);
+            const due = String(h.due_date || h.due_at?.slice(0, 10) || "");
+            const editable = homeworkEditable(h);
+            return (
+              <li key={String(h.id)} className="flex flex-wrap items-center gap-2 rounded-xl border bg-[var(--card)] p-3">
+                <button type="button" disabled={homeworkBusy === String(h.id)} onClick={() => void toggleHomework(h)} aria-label={hs === "done" ? "Отметить как невыполненное" : "Отметить выполненным"} className={hs === "done" ? "text-[var(--status-ok-fg)]" : "text-slate-300"}>
+                  <CheckCircle2 className="h-5 w-5" />
+                </button>
+                <div className="min-w-0 flex-1">
+                  <b className={hs === "done" ? "line-through opacity-60" : ""}>{h.title}</b>
+                  <div className="mt-0.5 flex flex-wrap items-center gap-1.5 text-xs opacity-70">
+                    {h.subject_name && <span className="inline-flex items-center gap-1"><span className="h-2 w-2 rounded-full" style={{ background: subjectColor(h) }} />{h.subject_name}</span>}
+                    {due && <span>· срок {shortDateRu(due)}</span>}
+                    {hs === "overdue" && <span className="rounded-full bg-[var(--status-critical-bg)] px-1.5 py-0.5 font-semibold text-[var(--status-critical-fg)]">просрочено</span>}
+                    {hs === "done" && <span className="rounded-full bg-[var(--status-ok-bg)] px-1.5 py-0.5 font-semibold text-[var(--status-ok-fg)]">готово</span>}
+                    {hs !== "done" && hs !== "overdue" && homeworkStatusLabel(h) && <span className="rounded-full bg-[var(--status-warn-bg)] px-1.5 py-0.5 font-semibold text-[var(--status-warn-fg)]">{homeworkStatusLabel(h)}</span>}
+                  </div>
+                </div>
+                {editable && (
+                  <button
+                    type="button"
+                    disabled={homeworkBusy === String(h.id)}
+                    onClick={() => void rescheduleHomework(h, 1)}
+                    title={`Перенести срок на ${shortDateRu(addDaysYmd(due || now.date, 1))}`}
+                    className="inline-flex items-center gap-1 rounded-lg border border-[var(--border)] px-2 py-1 text-xs font-semibold hover:border-[var(--primary)]"
+                  >
+                    {homeworkBusy === String(h.id) ? <Loader2 className="h-3.5 w-3.5 animate-spin" /> : <CalendarClock className="h-3.5 w-3.5" />}
+                    На день позже
+                  </button>
+                )}
+              </li>
+            );
+          })}
+        </ul>
+      )}
+    </details>
+  );
+}
diff --git a/src/components/schedule/LessonDrawer.tsx b/src/components/schedule/LessonDrawer.tsx
new file mode 100644
index 00000000..b30d1e3e
--- /dev/null
+++ b/src/components/schedule/LessonDrawer.tsx
@@ -0,0 +1,201 @@
+"use client";
+
+/**
+ * Панель занятия: ДЗ с ответом и вложениями, добавление ДЗ (включая умную
+ * вставку из чата), план занятия и самоотчёт о посещении. Разметка перенесена
+ * из `src/app/schedule/page.tsx` без изменений.
