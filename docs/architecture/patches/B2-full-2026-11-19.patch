-    const { data: subjects, error: subjectError } = await db.from("subjects").select("id").eq("slug", subjectSlug).limit(2);
-    if (subjectError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось сопоставить предмет пакета");
