# =============================================================================
# SpaceWeb: copy to .env next to backend/ (NOT inside public/)
# chmod 600 .env
# =============================================================================

APP_ENV=production
APP_DEBUG=false

# Vercel production + preview origins (comma-separated)
CORS_ORIGINS=https://medbiohim.vercel.app,https://*.vercel.app

# --- Supabase Auth (required for login) ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...anon
SUPABASE_SERVICE_KEY=eyJ...service_role

# --- Postgres ---
DB_HOST=db.YOUR_PROJECT.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# --- Backblaze B2 ---
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=medbiohim-files
B2_BUCKET_ID=
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
