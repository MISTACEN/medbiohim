+  // Домен есть только у разнесённых страниц. Читаем не всю папку (там живут и
+  // старые компоненты со своими флагами), а ровно те файлы домена, которые
+  // страница импортирует, — то есть её фактический код.
+  if (!domain) return pageSrc;
+  const dir = new URL(`../src/components/${domain}/`, import.meta.url);
+  const names = new Set();
+  for (const match of pageSrc.matchAll(new RegExp(`@/components/${domain}/([A-Za-z0-9_/-]+)`, "g"))) {
+    names.add(match[1]);
+  }
+  for (const name of [...names].sort()) {
+    for (const candidate of [`${name}.tsx`, `${name}.ts`, `${name}/index.tsx`, `${name}/index.ts`]) {
+      const target = new URL(candidate, dir);
+      if (!existsSync(target)) continue;
+      parts.push(readFileSync(target, "utf8"));
+      break;
+    }
+  }
+  return parts.join("\n");
+}
+
