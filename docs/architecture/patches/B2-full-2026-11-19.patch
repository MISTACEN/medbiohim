@@ -0,0 +1,55 @@
+import { ok, fail, requestId } from "../../lib/response";
+import { requireAuth } from "../../middleware/auth";
+import { SEARCH_EXAMPLES, normalizeSearchText, parseSearchIntent } from "../../lib/search-query";
+import { collect } from "./collect";
+
+import type { SearchRouter } from "./types";
+
+export function registerSuggestRoute(search: SearchRouter) {
+search.get("/suggest", requireAuth, async (c) => {
+  const rid = requestId();
+  const rawQuery = (c.req.query("q") || "").trim().slice(0, 120);
+  const limit = Math.min(Math.max(Number(c.req.query("limit") || 8), 1), 12);
+  const intent = parseSearchIntent(rawQuery);
+  const query = intent.query || rawQuery;
+  const queryTooShort = normalizeSearchText(query).length < 2;
+
+  if (queryTooShort && !intent.materialHint) {
+    return c.json(ok({
+      items: [],
+      query,
+      hint: "Введите название препарата, учебника или предмета",
+      examples: SEARCH_EXAMPLES,
+    }, rid));
+  }
+
+  try {
+    const collected = await collect(c, {
+      query: queryTooShort ? "" : query,
+      kind: intent.kind,
+      limit,
+      materialHint: intent.materialHint,
+      kinds: ["subjects", "preparations", "materials", "tests"],
+    });
+    return c.json(ok({
+      items: collected.items.map((item) => ({
+        id: item.id,
+        type: item.type,
+        type_label: item.type_label,
+        title: item.title,
+        subject: item.subject,
+        hint: item.hint,
+        href: item.href,
+        count: item.count || 1,
+      })),
+      query,
+      hint: intent.hint,
+      examples: SEARCH_EXAMPLES,
+    }, rid));
+  } catch (error) {
+    console.error("[search:suggest]", error);
+    const { body, status } = fail("DB_UNAVAILABLE", "Подсказки временно недоступны", 503, rid);
+    return c.json(body, status as 503);
+  }
+});
+}
diff --git a/workers/api/src/routes/search/collect.ts b/workers/api/src/routes/search/collect.ts
new file mode 100644
index 00000000..da503445
--- /dev/null
+++ b/workers/api/src/routes/search/collect.ts
@@ -0,0 +1,105 @@
+import { createServiceClient } from "../../lib/supabase";
+import { primaryTerm, TYPE_PRIORITY } from "./shared";
+import { scoreFields } from "../../lib/search-query";
+import type { CollectOptions, SearchHit, SearchKind, SourceContext, SubjectRow } from "./shared";
+import { addSubjects } from "./sources/subjects";
+import { addPreparations } from "./sources/preparations";
+import { addMaterials } from "./sources/materials";
+import { addLectures } from "./sources/lectures";
+import { addQuestions } from "./sources/questions";
+import { addTickets } from "./sources/tickets";
+import { addPacks } from "./sources/packs";
+import { addTests } from "./sources/tests";
+
+export async function collect(c: any, options: CollectOptions) {
+  // Контентные таблицы (trainer_feed_cards и др.) отдают данные только
+  // серверному клиенту: у authenticated гранты отозваны, и пользовательский
+  // клиент ронял весь поиск в 503. Фильтры is_published/is_active остаются.
+  const db = createServiceClient(c.env) || c.get("supabase");
+  const { query, subjectSlug, limit, materialHint } = options;
+  const include = (kind: SearchKind) => !options.kind || options.kind === kind;
+  const allowed = (kind: SearchKind) => !options.kinds || options.kinds.includes(kind);
+  const term = primaryTerm(query);
+  const results: SearchHit[] = [];
+
+  // Предметы нужны не только как результат, но и как «мостик»: по ним
+  // находятся материалы, лекции и билеты, если запрос содержит название предмета.
+  const { data: subjectRows, error: subjectError } = await db
+    .from("subjects")
+    .select("id,name,slug,description,course_number,semester")
+    .eq("is_active", true)
+    .limit(500);
+  if (subjectError) throw subjectError;
+
+  const subjects = ((subjectRows || []) as SubjectRow[]).map((row) => ({
+    ...row,
+    id: String(row.id),
+    name: String(row.name || ""),
+    slug: row.slug ? String(row.slug) : null,
+    score: scoreFields([row.name, row.slug], query),
+  }));
+  const matchedSubjects = subjects.filter((row) => row.score > 0);
+  const matchedIds = [...new Set(matchedSubjects.map((row) => row.id))];
+  const matchedSlugs = [...new Set(matchedSubjects.map((row) => row.slug).filter((slug): slug is string => Boolean(slug)))];
+  const subjectNameBySlug = new Map(subjects.filter((row) => row.slug).map((row) => [row.slug as string, row.name]));
+
+  const ctx: SourceContext = {
+    db, query, term, subjectSlug, materialHint, results, subjects, matchedSubjects, matchedIds, matchedSlugs, subjectNameBySlug, TYPE_PRIORITY,
+  };
+
+  if (include("subjects") && allowed("subjects")) {
+    await addSubjects(ctx);
+  }
+
+  if (include("preparations") && allowed("preparations") && (!subjectSlug || subjectSlug === "histology")) {
+    await addPreparations(ctx);
+  }
+
+  if (include("materials") && allowed("materials")) {
+    await addMaterials(ctx);
+  }
+
+  if (include("lectures") && allowed("lectures")) {
+    await addLectures(ctx);
+  }
+
+  if (include("questions") && allowed("questions")) {
+    await addQuestions(ctx);
+  }
+
+  if (include("tickets") && allowed("tickets")) {
+    await addTickets(ctx);
+  }
+
+  if (include("packs") && allowed("packs")) {
+    await addPacks(ctx);
+  }
+
+  if (include("tests") && allowed("tests")) {
+    await addTests(ctx);
+  }
+
+  results.sort((a, b) => (
+    b.score - a.score
+    || (TYPE_PRIORITY[b.type] || 0) - (TYPE_PRIORITY[a.type] || 0)
+    || a.title.localeCompare(b.title, "ru")
+  ));
+
+  const subjectCounts = new Map<string, { subject: string; subject_slug: string; count: number }>();
+  const typeCounts: Record<string, number> = {};
+  for (const result of results) {
+    typeCounts[result.type] = (typeCounts[result.type] || 0) + 1;
+    if (result.subject_slug) {
+      const current = subjectCounts.get(result.subject_slug)
+        || { subject: result.subject || result.subject_slug, subject_slug: result.subject_slug, count: 0 };
+      current.count += 1;
+      subjectCounts.set(result.subject_slug, current);
+    }
+  }
+
+  return {
+    items: results.slice(0, limit),
+    total: results.length,
+    facets: { subjects: [...subjectCounts.values()], types: typeCounts },
+  };
+}
diff --git a/workers/api/src/routes/search/shared.ts b/workers/api/src/routes/search/shared.ts
new file mode 100644
index 00000000..156d40ea
--- /dev/null
+++ b/workers/api/src/routes/search/shared.ts
@@ -0,0 +1,142 @@
+import { normalizeSearchText, type SearchIntentKind } from "../../lib/search-query";
+
+export type SearchKind = SearchIntentKind;
+
+export type SearchHit = {
+  type: string;
+  type_label: string;
+  id: string;
+  title: string;
+  subject: string;
+  subject_slug: string | null;
+  topic: string;
+  snippet: string;
+  hint: string;
+  has_answer: boolean;
+  answer?: string;
+  href: string;
+  score: number;
+  count?: number;
+};
+
+export const TYPE_LABEL: Record<string, string> = {
+  preparation: "Микропрепарат",
+  subject: "Предмет",
+  material: "Материал",
+  lecture: "Лекция",
+  question: "Вопрос",
+  ticket: "Билет",
+  test: "Тест",
+  pack: "Пак карточек",
+};
+
+/** При равном счёте важнее предмет и препарат, чем вопрос из практики. */
+export const TYPE_PRIORITY: Record<string, number> = {
+  subject: 6,
+  preparation: 5,
+  material: 4,
+  test: 3,
+  lecture: 3,
+  ticket: 2,
+  question: 1,
+  pack: 1,
+};
+
+export const MATERIAL_TYPE_LABEL: Record<string, string> = {
+  lecture: "Лекция",
+  pdf: "PDF",
+  pptx: "Презентация",
+  docx: "Word",
+  lab: "Лабораторная",
+  table: "Таблица",
+  html: "Страница",
+  video: "Видео",
+  other: "Материал",
+};
+
+export const KIND_ALIASES: Record<string, SearchKind> = {
+  question: "questions",
+  questions: "questions",
+  ticket: "tickets",
+  tickets: "tickets",
+  exam: "tickets",
+  lecture: "lectures",
+  lectures: "lectures",
+  material: "materials",
+  materials: "materials",
+  textbook: "materials",
+  textbooks: "materials",
+  preparation: "preparations",
+  preparations: "preparations",
+  subject: "subjects",
+  subjects: "subjects",
+  test: "tests",
+  tests: "tests",
+  pack: "packs",
+  packs: "packs",
+  cardpack: "packs",
+  cardpacks: "packs",
+};
+
+export function materialHintLabel(title: string, type: string): string {
+  const label = MATERIAL_TYPE_LABEL[String(type || "").toLowerCase()] || "Материал";
+  const lower = title.toLowerCase();
+  if (/учебник/.test(lower)) return `Учебник · ${label}`;
+  if (/атлас/.test(lower)) return `Атлас · ${label}`;
+  if (/лекц/.test(lower)) return `Курс лекций · ${label}`;
+  if (/методич|пособ/.test(lower)) return `Методичка · ${label}`;
+  return label;
+}
+
+export function relation<T>(value: T | T[] | null | undefined): T | null {
+  if (Array.isArray(value)) return value[0] ?? null;
+  return value ?? null;
+}
+
+export function primaryTerm(query: string): string {
+  return normalizeSearchText(query)
+    .split(" ")
+    .filter((word) => word.length >= 2)
+    .sort((a, b) => b.length - a.length)[0] || "";
+}
+
+export type SubjectRow = {
+  id: string;
+  name: string;
+  slug: string | null;
+  description?: string | null;
+  course_number?: number | null;
+  semester?: number | null;
+};
+
+export type CollectOptions = {
+  query: string;
+  kind?: SearchKind;
+  subjectSlug?: string;
+  limit: number;
+  /** «Учебник»/«атлас»: обязательный вид материала плюс бонус к ранжированию. */
+  materialHint?: string;
+  /** Для подсказок не трогаем тяжёлые разделы. */
+  kinds?: SearchKind[];
+};
+
+export type SourceContext = {
+  db: any;
+  query: string;
+  term: string;
+  subjectSlug?: string;
+  materialHint?: string;
+  results: SearchHit[];
+  subjects: Array<SubjectRow & { score: number }>;
+  matchedSubjects: Array<SubjectRow & { score: number }>;
+  matchedIds: string[];
+  matchedSlugs: string[];
+  subjectNameBySlug: Map<string, string>;
+  TYPE_PRIORITY: Record<string, number>;
+};
+
+export function readKind(raw: string): SearchKind | undefined | "invalid" {
+  const normalized = String(raw || "").trim().toLowerCase();
+  if (!normalized || normalized === "all") return undefined;
+  return KIND_ALIASES[normalized] || "invalid";
+}
diff --git a/workers/api/src/routes/search/sources/lectures.ts b/workers/api/src/routes/search/sources/lectures.ts
new file mode 100644
index 00000000..0ca93653
