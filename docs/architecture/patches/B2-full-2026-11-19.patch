+            >
+              Следующий
+            </button>
+          )}
+          {view.isLast && (
+            <button onClick={() => void finish(false)} className="btn-primary">
+              Завершить тест
+            </button>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
