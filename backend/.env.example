APP_ENV=production
APP_DEBUG=false

CORS_ORIGINS=https://medbiohim.vercel.app,https://*.vercel.app

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...anon
SUPABASE_SERVICE_KEY=eyJ...service_role

# P0: SpaceWeb IPv4 → use Session pooler DB_URL (takes priority over DB_HOST)
# Supabase → Database → Connection string → Session pooler
# DB_URL=postgres://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_URL=
DB_HOST=db.YOUR_PROJECT.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require

ADMIN_BOOTSTRAP_SECRET=medbiohim-admin-2026

B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=medbiohim-files
B2_BUCKET_ID=
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
