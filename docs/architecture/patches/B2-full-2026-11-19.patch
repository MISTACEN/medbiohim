+    setPlan(coreLoad.plan);
+    setTests(coreLoad.tests);
+    setResourceErrors(coreLoad.resourceErrors);
+  }, [coreLoad]);
+
+  const auxSubjectId = coreLoad?.ready ? coreLoad.subjectId : "";
+  const auxSlug = coreLoad?.ready ? coreLoad.slug : "";
