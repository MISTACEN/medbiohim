APP_ENV=production
APP_DEBUG=0
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...service_role...
DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
CORS_ORIGINS=https://medbiohim.vercel.app,http://localhost:3000
ADMIN_BOOTSTRAP_SECRET=change-me
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=medbiohim-files
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003

# Optional LLM for AI-tutor (OpenAI-compatible). Without key — local RAG still works.
LLM_API_KEY=
# OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
