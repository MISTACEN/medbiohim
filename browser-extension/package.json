{
  "name": "medbiohim-eios-importer",
  "version": "1.1.0",
  "description": "Browser extension for importing FESMU/EIOS content into MEDBIOHIM platform",
  "manifest_version": 3,
  "type": "module",
  "scripts": {
    "build": "webpack --config webpack.config.cjs --mode production",
    "watch": "webpack --config webpack.config.cjs --mode development --watch",
    "dev": "webpack --config webpack.config.cjs --mode development",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.258",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "ts-loader": "^9.4.4",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  }
}
