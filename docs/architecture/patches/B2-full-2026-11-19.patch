+      .select("card_id,is_correct,is_skipped,created_at")
+      .eq("user_id", user.id)
+      .order("created_at", { ascending: true })
+      .limit(5000);
+    if (error) throw error;
+    const rows = answers || [];
+    if (!rows.length) {
+      return c.json(ok({ summary: { answered: 0, correct: 0, accuracy: null, cards: 0 }, by_card: [], by_topic: [], mistakes: [] }, rid));
+    }
+
+    const cardIds = Array.from(new Set(rows.map((row: any) => String(row.card_id))));
+    const { data: cards, error: cardsError } = await supabase
+      .from("trainer_feed_cards")
+      .select("id,plan_topic_id,topics(title)")
+      .in("id", cardIds)
+      .limit(500);
+    if (cardsError) throw cardsError;
+    const topicByCard = new Map<string, string | null>(
+      (cards || []).map((row: any) => [String(row.id), (Array.isArray(row.topics) ? row.topics[0]?.title : row.topics?.title) || null])
+    );
+
+    const byCard = new Map<string, { attempts: number; correct: number; skipped: number; last_correct: boolean | null; last_skipped: boolean; last_at: string }>();
+    for (const row of rows) {
+      const key = String(row.card_id);
+      const agg = byCard.get(key) || { attempts: 0, correct: 0, skipped: 0, last_correct: null, last_skipped: false, last_at: "" };
+      agg.attempts += 1;
+      if (row.is_correct === true) agg.correct += 1;
+      if (row.is_skipped === true) agg.skipped += 1;
+      if (row.is_skipped === true) {
+        agg.last_skipped = true;
+      } else {
+        agg.last_correct = row.is_correct === true;
+        agg.last_skipped = false;
+      }
+      agg.last_at = String(row.created_at || "");
+      byCard.set(key, agg);
+    }
+
+    const byCardItems = Array.from(byCard, ([card_id, agg]) => {
+      const graded = agg.attempts - agg.skipped;
+      return {
+        card_id,
+        topic: topicByCard.get(card_id) || null,
+        attempts: agg.attempts,
+        correct: agg.correct,
+        skipped: agg.skipped,
+        accuracy: graded > 0 ? Math.round((agg.correct / graded) * 100) : null,
+        last_correct: agg.last_correct,
+        last_skipped: agg.last_skipped,
+        last_answered_at: agg.last_at,
+      };
+    });
+
+    const byTopicMap = new Map<string, { topic: string; attempts: number; correct: number; cards: number }>();
+    for (const item of byCardItems) {
+      const key = item.topic || "Без темы";
+      const agg = byTopicMap.get(key) || { topic: key, attempts: 0, correct: 0, cards: 0 };
+      agg.attempts += item.attempts - item.skipped;
+      agg.correct += item.correct;
+      agg.cards += 1;
+      byTopicMap.set(key, agg);
+    }
+    const byTopic = Array.from(byTopicMap.values())
+      .map((agg) => ({ ...agg, accuracy: agg.attempts > 0 ? Math.round((agg.correct / agg.attempts) * 100) : null }))
+      .sort((a, b) => (a.accuracy ?? 101) - (b.accuracy ?? 101));
+
+    // Очередь ошибок: последний ответ неверный или был пропуском.
+    const mistakes = byCardItems
+      .filter((item) => item.last_correct === false || item.last_skipped)
+      .sort((a, b) => String(a.last_answered_at).localeCompare(String(b.last_answered_at)))
+      .slice(0, 50);
+
+    const answered = rows.filter((row: any) => row.is_skipped !== true).length;
+    const correct = rows.filter((row: any) => row.is_correct === true).length;
+
+    return c.json(ok({
+      summary: { answered, correct, accuracy: answered ? Math.round((correct / answered) * 100) : null, cards: byCard.size },
+      by_card: byCardItems.sort((a, b) => String(b.last_answered_at).localeCompare(String(a.last_answered_at))).slice(0, 100),
+      by_topic: byTopic,
+      mistakes,
+    }, rid));
+  } catch (error) {
+    console.error("[trainers:stats]", error);
+    const { body, status } = fail("DB_UNAVAILABLE", "Статистика тренажёра недоступна", 503, rid);
+    return c.json(body, status as 503);
+  }
+});
+}
diff --git a/workers/api/src/routes/trainers/02-answer.ts b/workers/api/src/routes/trainers/02-answer.ts
new file mode 100644
index 00000000..5aa2949f
--- /dev/null
+++ b/workers/api/src/routes/trainers/02-answer.ts
@@ -0,0 +1,83 @@
+import { ok, fail, requestId } from "../../lib/response";
+import { requireAuth } from "../../middleware/auth";
+import { createServiceClient } from "../../lib/supabase";
+
+import type { TrainersRouter } from "./types";
+
+export function registerAnswerRoutes(trainers: TrainersRouter) {
+trainers.post("/feed/answer", requireAuth, async (c) => {
+  const rid = requestId();
+  const user = c.get("user");
+  const supabase = c.get("supabase");
+  let payload: { card_id?: string; answer?: string; option_id?: string; answer_text?: string; is_skipped?: boolean; time_ms?: number } = {};
+  try {
+    payload = await c.req.json();
+  } catch {
+    const { body, status } = fail("VALIDATION", "Некорректный JSON", 400, rid);
+    return c.json(body, status as 400);
+  }
+  if (!payload.card_id) {
+    const { body, status } = fail("VALIDATION", "Нужен card_id", 400, rid);
+    return c.json(body, status as 400);
+  }
+  try {
+    // Штатный путь — SECURITY DEFINER-функция: она сама считает is_correct и
+    // не доверяет клиенту. Прямого доступа к таблицам у пользователя нет.
+    const { data, error } = await supabase.rpc("submit_trainer_feed_answer", {
+      p_card_id: payload.card_id,
+      p_option_id: payload.option_id ?? null,
+      p_answer_text: payload.answer_text ?? payload.answer ?? null,
+      p_is_skipped: payload.is_skipped === true,
+      p_time_ms: Number.isFinite(payload.time_ms) ? Math.max(0, Math.min(3600000, Number(payload.time_ms))) : null,
+    });
+    if (!error && data) return c.json(ok(data, rid));
+    if (error) console.error("[trainers:answer:rpc]", error.message);
+
+    // Резервный серверный путь для ответов старого формата.
+    const service = createServiceClient(c.env);
+    if (!service) {
+      const { body, status } = fail("DB_UNAVAILABLE", "Не удалось сохранить ответ", 503, rid);
+      return c.json(body, status as 503);
+    }
+    const { data: card, error: cardError } = await service
+      .from("trainer_feed_cards")
+      .select("question")
+      .eq("id", payload.card_id)
+      .eq("is_published", true)
+      .maybeSingle();
+    if (cardError || !card) {
+      const { body, status } = fail("NOT_FOUND", "Карточка тренажёра не найдена", 404, rid);
+      return c.json(body, status as 404);
+    }
+    const answerValue = String(payload.option_id || payload.answer || payload.answer_text || "").trim();
+    const question = (card.question || {}) as { options?: unknown };
+    const options = Array.isArray(question.options) ? question.options as { id?: unknown; label?: unknown; correct?: unknown }[] : [];
+    const selected = options.find((option) =>
+      String(option.id ?? "") === answerValue || String(option.label ?? "").trim().toLocaleLowerCase() === answerValue.toLocaleLowerCase()
+    );
+    const isSkipped = payload.is_skipped === true || !answerValue;
+    const { data: inserted, error: insErr } = await service
+      .from("trainer_feed_answers")
+      .insert({
+        card_id: payload.card_id,
+        user_id: user.id,
+        option_id: selected ? String(selected.id ?? "") : null,
+        answer_text: selected ? null : (answerValue || null),
+        is_skipped: isSkipped,
+        is_correct: isSkipped ? null : (selected ? Boolean(selected.correct) : false),
+        time_ms: Number.isFinite(payload.time_ms) ? Math.max(0, Math.min(3600000, Number(payload.time_ms))) : null,
+      })
+      .select("id,card_id,option_id,answer_text,is_correct,is_skipped,time_ms,created_at")
+      .maybeSingle();
+    if (insErr) {
+      console.error("[trainers:answer]", insErr.message);
+      const { body, status } = fail("DB_UNAVAILABLE", "Не удалось сохранить ответ", 503, rid);
+      return c.json(body, status as 503);
+    }
+    return c.json(ok(inserted, rid));
+  } catch {
+    const { body, status } = fail("DB_UNAVAILABLE", "Не удалось сохранить ответ", 503, rid);
+    return c.json(body, status as 503);
+  }
+});
+}
diff --git a/workers/api/src/routes/trainers/03-image.ts b/workers/api/src/routes/trainers/03-image.ts
new file mode 100644
index 00000000..1ec81c4d
--- /dev/null
+++ b/workers/api/src/routes/trainers/03-image.ts
@@ -0,0 +1,247 @@
+import { ok, fail, requestId } from "../../lib/response";
+import { createAnonClient, createServiceClient } from "../../lib/supabase";
+import { BlobError } from "@upstash/blob";
+import { getBlobBucket, trainerImageCandidateKeys, findHistologyDriveItem, imageContentType } from "./shared";
+
+import type { TrainersRouter } from "./types";
+
+export function registerImageRoutes(trainers: TrainersRouter) {
+trainers.get("/feed/:id/image", async (c) => {
+  const rid = requestId();
+  // Public media endpoint: only published cards can resolve to image bytes.
+  // Prefer the server-only service client for metadata lookups; fall back to anon + RLS.
+  const supabase = createServiceClient(c.env) || createAnonClient(c.env);
+  // Public Blob reads do not require UPSTASH_BLOB_TOKEN. This route intentionally
+  // does not require a user session: it exposes bytes only for published cards.
+  // Keep the SDK as a compatibility fallback only.
+  const bucket = getBlobBucket(c.env);
+
+  try {
+    let cardResult = await supabase
+      .from("trainer_feed_cards")
+      .select("id,subject_slug,specialty_slug,preparation,source_key,mode_set,is_published")
+      .eq("id", c.req.param("id"))
+      .eq("is_published", true)
+      .maybeSingle();
+
+    // The feed can be served through the service-role fallback when user-scoped
+    // RLS hides trainer cards. Image resolution must use the same fallback or it
+    // incorrectly reports 404 for cards that are present in the feed.
+    if (cardResult.error || !cardResult.data) {
+      const { createServiceClient } = await import("../../lib/supabase");
+      const service = createServiceClient(c.env);
+      if (service) {
+        const fallback = await service
+          .from("trainer_feed_cards")
+          .select("id,subject_slug,specialty_slug,preparation,source_key,mode_set,is_published")
+          .eq("id", c.req.param("id"))
+          .eq("is_published", true)
+          .maybeSingle();
+        if (!fallback.error && fallback.data) cardResult = fallback;
+        else if (fallback.error) console.error("[trainer-image:service-fallback]", fallback.error.message);
+      }
+    }
+
+    const { data: card, error } = cardResult;
+    if (error) {
+      console.error("[trainer-image:card-query]", error.message);
+      const { body, status } = fail("DB_UNAVAILABLE", "Не удалось получить карточку изображения", 503, rid);
+      return c.json(body, status as 503);
+    }
+    if (!card) {
+      const { body, status } = fail("NOT_FOUND", "Карточка не найдена", 404, rid);
+      return c.json(body, status as 404);
+    }
+    if (!card.is_published) {
+      const { body, status } = fail("NOT_FOUND", "У карточки нет изображения", 404, rid);
+      return c.json(body, status as 404);
+    }
+
+    let fileObjectKey: string | null = null;
+    const sourceKey = typeof card.source_key === "string" ? card.source_key.trim() : "";
+    // Many EM cards store a Blob-relative path in source_key (not a content_sources UUID).
+    // Only query content_sources when the key looks like a UUID — otherwise path lookup throws / 22P02.
+    const sourceKeyLooksLikeUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(sourceKey);
+    if (sourceKeyLooksLikeUuid) {
+      const { data: source, error: sourceError } = await supabase.from("content_sources")
+        .select("source_path,file_id")
+        .eq("id", sourceKey)
+        .maybeSingle();
+      if (sourceError) throw sourceError;
+      if (source?.file_id) {
+        const { data: file, error: fileError } = await supabase.from("files")
+          .select("object_key,mime_type")
+          .eq("id", source.file_id)
+          .maybeSingle();
+        if (fileError) throw fileError;
+        const objectKey = typeof file?.object_key === "string" ? file.object_key.trim() : "";
+        if (objectKey) fileObjectKey = objectKey;
+      }
+      if (source?.source_path && !(card.preparation as any)?.imagePath) {
+        card.preparation = { ...(card.preparation as object || {}), imagePath: source.source_path };
+      }
+    }
+
+    // ?variant=clean — версия скана БЕЗ подписей для вопросов тренажёра:
+    // preparation.imageCleanUrl — полный публичный URL (Vercel-статика),
+    // ставится SQL'ом 20261115_clean_em_urls. Подписанная версия остаётся
+    // для атласа и объяснения после ответа.
+    const wantsClean = c.req.query("variant") === "clean";
+    const prep = (card.preparation as Record<string, any> | null) || null;
+    if (wantsClean && prep?.imageCleanUrl) {
+      // Чистая версия лежит на Vercel-статике — redirect дешевле, чем
+      // проксировать бинарник через воркер.
+      const cleanUrl = String(prep.imageCleanUrl);
+      if (/^https:\/\//.test(cleanUrl)) {
+        return c.redirect(cleanUrl, 302);
+      }
+      // Fallback на blob-путь, если imageCleanUrl не URL, а blob-ключ.
+      if (!sourceKeyLooksLikeUuid) {
+        card.preparation = { ...prep, imagePath: String(prep.imageCleanPath || prep.imageCleanUrl) };
+      }
+    }
+
+    const candidates = trainerImageCandidateKeys(
+      {
+        source_key: card.source_key,
+        mode_set: (card as any).mode_set ?? null,
+        preparation: card.preparation as Record<string, unknown> | null,
+      },
+      fileObjectKey,
+    );
+
+    // Temporary migration path: public Google Drive is the active histology source
+    // while the Upstash Blob bucket credential is unavailable.
+    //
+    // Электронограммы — самая медленная часть тренажёра: uc?export=download
+    // отдаёт оригинал в несколько МБ через медленный эндпоинт Drive. Картинки
+    // по умолчанию идут РАСТРОВЫМ thumbnail (sz=w2000 — с запасом для ретины),
+    // полный оригинал — только по ?variant=full. Кэш длинный: картинка карточки
+    // неизменяема (ключ = id карточки), повторные открытия должны браться из
+    // браузера/CDN без похода к воркеру.
+    const wantsFull = c.req.query("variant") === "full";
+    const MEDIA_CACHE = "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400";
+    const isHistologyDriveCard =
+      String((card as any).subject_slug || "") === "histology" &&
+      String((card as any).specialty_slug || "") === "mbh";
+    const driveItem = isHistologyDriveCard
+      ? findHistologyDriveItem(
+          { mode_set: (card as any).mode_set ?? null, preparation: card.preparation as Record<string, unknown> | null },
+          candidates,
+        )
+      : null;
+    if (driveItem) {
+      const driveUrl = driveItem.kind === "image" && !wantsFull
+        ? `https://drive.google.com/thumbnail?id=${encodeURIComponent(driveItem.id)}&sz=w2000`
+        : driveItem.kind === "image"
+          ? `https://drive.google.com/uc?export=download&id=${encodeURIComponent(driveItem.id)}`
+          : `https://drive.google.com/thumbnail?id=${encodeURIComponent(driveItem.id)}&sz=w1600`;
+      try {
+        const driveResponse = await fetch(driveUrl, { redirect: "follow" });
+        const driveContentType = driveResponse.headers.get("content-type") || driveItem.mime;
+        if (driveResponse.ok && driveResponse.body && driveContentType.toLowerCase().startsWith("image/")) {
+          return new Response(driveResponse.body, {
+            headers: {
+              "content-type": driveContentType,
+              "cache-control": MEDIA_CACHE,
+              "x-content-type-options": "nosniff",
+              "x-request-id": rid,
+              "x-mbh-media-key": driveItem.path,
+              "x-mbh-image-resolver": wantsFull ? "google-drive-full" : "google-drive-thumbnail",
+            },
+          });
+        }
+        console.warn("[trainer-image:google-drive] image unavailable; falling back to Blob", {
+          cardId: card.id,
+          driveFileId: driveItem.id,
+          status: driveResponse.status,
+          contentType: driveContentType,
+        });
+      } catch (driveError) {
+        console.warn("[trainer-image:google-drive] fetch failed; falling back to Blob", {
+          cardId: card.id,
+          driveFileId: driveItem.id,
+          error: driveError instanceof Error ? driveError.message : String(driveError),
+        });
+      }
+    }
+
+    if (!candidates.length) {
+      console.warn("[trainer-image] missing/invalid preparation image path", { cardId: card.id });
+      const { body, status } = fail("MEDIA_URL_UNAVAILABLE", "Для изображения не задан корректный ключ хранилища", 503, rid);
+      return c.json(body, status as 503);
+    }
+
+    let image: any = null;
+    let resolvedKey = "";
+    const key = candidates[0];
+
+    const publicBlobBase = (c.env.UPSTASH_BLOB_PUBLIC_BASE_URL || "https://b8a4f9f853fa.blob.upstash.io").trim().replace(/\/+$/, "");
+    for (const candidate of candidates) {
+      const publicUrl = `${publicBlobBase}/${candidate.split("/").map((part) => encodeURIComponent(part)).join("/")}`;
+      try {
+        const publicResponse = await fetch(publicUrl, { redirect: "follow" });
+        if (publicResponse.ok && publicResponse.body) {
+          return new Response(publicResponse.body, {
+            headers: {
+              "content-type": publicResponse.headers.get("content-type") || imageContentType(candidate),
+              "cache-control": MEDIA_CACHE,
+              "x-content-type-options": "nosniff",
+              "x-request-id": rid,
+              "x-mbh-media-key": candidate,
+              "x-mbh-image-resolver": "v2",
+            },
+          });
+        }
+        if (publicResponse.status === 404) {
+          console.warn("[trainer-image] public URL returned 404; falling back to authenticated Blob SDK", { cardId: card.id, key: candidate });
+        }
+      } catch (error) {
+        console.warn("[trainer-image] public Blob URL lookup failed; trying authenticated SDK", {
+          cardId: card.id,
+          key: candidate,
+          error: error instanceof Error ? error.message : String(error),
+        });
+      }
+      if (bucket) {
+        try {
+          image = await bucket.get(candidate);
+          if (image) { resolvedKey = candidate; break; }
+        } catch (error) {
+          if (BlobError.is(error) && error.code === "not_found") continue;
+          // Public reads are the primary path; an invalid/expired private token
+          // must not prevent already-public objects from being served.
+          console.warn("[trainer-image] authenticated Blob fallback failed", {
+            cardId: card.id,
+            key: candidate,
+            error: error instanceof Error ? error.message : String(error),
+          });
+        }
+      }
+    }
+    if (!image) {
+      console.warn("[trainer-image] object not found", { cardId: card.id, candidates });
+      const { body, status } = fail("MEDIA_NOT_FOUND", "Файл изображения отсутствует в Upstash Blob", 404, rid);
+      if (body && typeof body === "object" && (body as any).error) {
+        (body as any).error.details = { resolver: "v2", tried: candidates.slice(0, 12) };
+      }
+      return c.json(body, status as 404);
+    }
+
+    return new Response(image.body, {
+      headers: {
+        "content-type": image.contentType || imageContentType(key),
+        "cache-control": MEDIA_CACHE,
+        "x-content-type-options": "nosniff",
+        "x-request-id": rid,
+        "x-mbh-media-key": resolvedKey,
+        "x-mbh-image-resolver": "v2",
+      },
+    });
+  } catch (error) {
+    console.error("[trainer-image]", error);
+    const { body, status } = fail("MEDIA_URL_UNAVAILABLE", "Не удалось получить изображение из хранилища", 503, rid);
+    return c.json(body, status as 503);
+  }
+});
+}
diff --git a/workers/api/src/routes/trainers/shared.ts b/workers/api/src/routes/trainers/shared.ts
new file mode 100644
index 00000000..662cba5b
--- /dev/null
+++ b/workers/api/src/routes/trainers/shared.ts
@@ -0,0 +1,222 @@
+import { Hono } from "hono";
+import { Bucket } from "@upstash/blob";
+import type { Env } from "../../env";
+import histologyDriveIndex from "../../data/histology-drive-index.json";
+
+export function getBlobBucket(env: Env): Bucket | null {
+  const token = env.UPSTASH_BLOB_TOKEN?.trim();
+  return token ? new Bucket({ token, enableTelemetry: false, cache: "no-store" }) : null;
+}
+
+export type TrainerRow = {
+  id: string;
+  subject_slug?: string | null;
+  specialty_slug?: string | null;
+  mode_set?: string | null;
+  source_key?: string | null;
+  preparation?: Record<string, unknown> | null;
+  question?: Record<string, unknown> | null;
+  tags?: string[] | null;
+  difficulty?: number | null;
+  plan_module_id?: string | null;
+  plan_topic_id?: string | null;
+  plan_status?: string | null;
+  modules?: { title?: string | null } | Array<{ title?: string | null }> | null;
+  topics?: { title?: string | null } | Array<{ title?: string | null }> | null;
+  is_published?: boolean;
+};
+
+export function cleanLegacyPath(value: string): string {
+  return String(value || "")
+    .trim()
+    .replace(/^\.\//, "")
+    .replace(/^\/+/, "")
+    .replace(/^content\/histology\//, "")
+    .replace(/^histology\//, "");
+}
+
+export function safeObjectKey(value: string): string {
+  const key = String(value || "").trim();
+  if (!key || key.length > 1024 || key.startsWith("/") || key.includes("\\") || /[?#\u0000-\u001f\u007f]/u.test(key)) return "";
+  const parts = key.split("/");
+  if (parts.some((part) => !part || part === "." || part === "..")) return "";
+  return key;
+}
+
+/** Expand relative/absolute paths into bare + histology/ + content/histology/ forms. */
+export function withHistologyPrefixes(relativeOrAbsolute: string): string[] {
+  const keys: string[] = [];
+  const add = (v: string) => {
+    const k = safeObjectKey(v);
+    if (k && !keys.includes(k)) keys.push(k);
+  };
+  const raw = String(relativeOrAbsolute || "").trim().replace(/^\/+/, "");
+  if (!raw) return keys;
+  add(raw);
+  const stripped = cleanLegacyPath(raw);
+  if (stripped) {
+    add("histology/" + stripped); // live public bucket layout
+    add(stripped);
+    add("content/histology/" + stripped);
+  }
+  return keys;
+}
+
+/**
+ * Ordered Blob object keys for a trainer card.
+ * Live bucket uses histology/… prefix (verified: histology/electronograms/images/apoptoz.png = 200).
+ * Cards often store only a basename in preparation.imagePath — expand under photo roots.
+ */
+// roots include "photos/" for legacy aliases
+export function trainerImageCandidateKeys(card: {
+  source_key?: string | null;
+  mode_set?: string | null;
+  preparation?: Record<string, unknown> | null;
+}, fileObjectKey: string | null = null): string[] {
+  const keys: string[] = [];
+  const add = (v: string) => {
+    for (const k of withHistologyPrefixes(v)) {
+      if (!keys.includes(k)) keys.push(k);
+    }
+  };
+
+  if (fileObjectKey) {
+    add(fileObjectKey);
+    return keys;
+  }
+
+  if (card.source_key) add(String(card.source_key));
+
+  const preparation = card.preparation && typeof card.preparation === "object" ? card.preparation : {};
+  const imagePath = cleanLegacyPath(String(preparation.imagePath || ""));
+  const imageUrl = cleanLegacyPath(String(preparation.imageUrl || ""));
+  add(imagePath);
+  add(imageUrl);
+
+  const base = (imagePath || imageUrl).split("/").pop() || "";
+  if (base && !base.includes("..")) {
+    if (card.mode_set === "electronogram") {
+      add("electronograms/images/" + base);
+      add("em/" + base);
+    }
+    // preparation (and unknown mode): try SpaceWeb photo tree
+    if (card.mode_set === "preparation" || !card.mode_set) {
+      const photoRoot = "5_Фотографии препаратов/";
+      const subfolders = [
+        "",
+        "частная гистология/",
+        "цитология, эмбриология и общая гистология/",
+        "стом. гистология/",
+      ];
+      if (imagePath.includes("/")) add(photoRoot + imagePath);
+      if (imageUrl.includes("/")) add(photoRoot + imageUrl);
+      for (const sub of subfolders) add(photoRoot + sub + base);
+    }
+  }
+  return keys;
+}
+
+export function mapTrainerCard(row: TrainerRow, orderIndex: number) {
+  const preparation = row.preparation || {};
+  const question = (row.question || {}) as { prompt?: unknown; mode?: unknown; options?: unknown };
+  const options = Array.isArray(question.options)
+    ? question.options.map((option: unknown, index: number) => {
+        const item = option as { id?: unknown; label?: unknown };
+        return { id: String(item.id ?? index), label: String(item.label ?? "") };
+      })
+    : [];
+  const moduleRow = Array.isArray(row.modules) ? row.modules[0] : row.modules;
+  const topicRow = Array.isArray(row.topics) ? row.topics[0] : row.topics;
+  return {
+    id: row.id,
+    plan_module_id: row.plan_module_id || null,
+    plan_topic_id: row.plan_topic_id || null,
+    plan_status: row.plan_status || null,
+    plan_module_title: moduleRow?.title || null,
+    plan_topic_title: topicRow?.title || null,
+    title: String(preparation.name || preparation.organ || question.prompt || "Карточка тренажёра"),
+    topic: Array.isArray(row.tags) ? String(row.tags[0] || row.subject_slug || "histology") : (row.subject_slug || "histology"),
+    kind: row.mode_set || String(question.mode || "identify"),
+    order_index: orderIndex,
+    has_image: Boolean(preparation.imageUrl || preparation.imagePath),
+    prompt: String(question.prompt || ""),
+    options,
+    preparation,
+    tags: row.tags || [],
+    difficulty: row.difficulty ?? null,
+  };
+}
+
+export type HistologyDriveItem = { path: string; name: string; id: string; kind: "image" | "document"; mime: string };
+export const HISTOLOGY_DRIVE_ITEMS = (histologyDriveIndex as { items: HistologyDriveItem[] }).items;
+
+export function normalizeDriveValue(value: string): string {
+  return String(value || "")
+    .normalize("NFKC")
+    .replace(/\\/g, "/")
+    .replace(/^\/+|^\.\//g, "")
+    .replace(/^content\/histology\//i, "")
+    .replace(/^histology\//i, "")
+    .replace(/\s+/g, " ")
+    .toLocaleLowerCase("ru-RU")
+    .trim();
+}
+
+export function normalizeDriveTitle(value: string): string {
+  return normalizeDriveValue(value)
+    .replace(/\.docx$/i, "")
+    .replace(/[()!.,:;—–-]/g, " ")
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+/** Resolve public Drive files from a checked-in index generated from the shared histology folder. */
+export function findHistologyDriveItem(
+  card: { mode_set?: string | null; preparation?: Record<string, unknown> | null },
+  candidates: string[],
+): HistologyDriveItem | null {
+  const preparation = card.preparation && typeof card.preparation === "object" ? card.preparation : {};
+  if (card.mode_set === "electronogram") {
+    const title = String(preparation.name || preparation.organ || "").trim();
+    if (!title) return null;
+    return HISTOLOGY_DRIVE_ITEMS.find((item) =>
+      item.kind === "document" && normalizeDriveTitle(item.name) === normalizeDriveTitle(title)
+    ) || null;
+  }
+
+  const imageItems = HISTOLOGY_DRIVE_ITEMS.filter((item) => item.kind === "image");
+  const driveCandidates = [
+    ...candidates,
+    String(preparation.imagePath || ""),
+    String(preparation.imageUrl || ""),
+  ].filter(Boolean);
+  // Prefer full relative paths so duplicate basenames in different folders remain unambiguous.
+  for (const candidate of driveCandidates) {
+    const normalized = normalizeDriveValue(cleanLegacyPath(candidate));
+    if (!normalized.includes("/")) continue;
+    const found = imageItems.find((item) => normalizeDriveValue(item.path) === normalized);
+    if (found) return found;
+  }
+
+  // Last resort: accept a basename only if it is unique in the shared folder index.
+  const basenames = new Set<string>();
+  for (const candidate of driveCandidates) {
+    const basename = normalizeDriveValue(cleanLegacyPath(candidate).split("/").pop() || "");
+    if (basename) basenames.add(basename);
+  }
+  for (const basename of basenames) {
+    const matches = imageItems.filter((item) => normalizeDriveValue(item.name) === basename);
+    if (matches.length === 1) return matches[0];
+  }
+  return null;
+}
+
+export function imageContentType(key: string): string {
+  const ext = key.split(".").pop()?.toLowerCase();
+  if (ext === "jpg" || ext === "jpeg") return "image/jpeg";
+  if (ext === "png") return "image/png";
+  if (ext === "gif") return "image/gif";
+  if (ext === "webp") return "image/webp";
+  if (ext === "svg") return "image/svg+xml";
+  return "application/octet-stream";
+}
