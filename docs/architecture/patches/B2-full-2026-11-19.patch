+++ b/workers/api/src/routes/admin/telegram.ts
@@ -0,0 +1,170 @@
+import { requireAuth } from "../../middleware/auth";
+import { ok, requestId } from "../../lib/response";
+import { createServiceClient } from "../../lib/supabase";
+import { publishTelegramHomework, updateMessageClassification } from "../../lib/telegram-homework";
+import { gigachatConfigured, gigachatTransport } from "../../lib/gigachat";
+import { workersAiConfigured, workersAiModel } from "../../lib/workers-ai";
+import { STRICT_ADMINS, UUID, bodyJson, error, gate, type AdminApp } from "./shared";
+
+/**
+ * Telegram-чаты, очередь сообщений, публикация задания и webhook.
+ */
+export function registerTelegram(admin: AdminApp) {
+
+
+  // Telegram chat management. Bot token and webhook secret are Worker secrets only.
+  admin.get("/telegram/ai-status", requireAuth, async (c) => {
+    const rid = requestId();
+    if (!await gate(c, ["admin", "moderator"])) return;
+    return c.json(ok({
+      provider: String(c.env.AI_SORT_PROVIDER || "cloudflare"),
+      cloudflareAi: {
+        configured: workersAiConfigured(c.env),
+        model: workersAiModel(c.env),
+      },
+      gigachat: {
+        configured: gigachatConfigured(c.env),
+        transport: gigachatTransport(c.env),
+        model: String(c.env.GIGACHAT_MODEL || "GigaChat"),
+      },
+      ingest: {
+        configured: Boolean(
+          c.env.TELEGRAM_INGEST_SECRET || c.env.TELEGRAM_WEBHOOK_SECRET || c.env.TELEGRAM_BOT_VERIFY_INGEST_URL
+        ),
+        verifier: c.env.TELEGRAM_INGEST_SECRET || c.env.TELEGRAM_WEBHOOK_SECRET
+          ? "local"
+          : c.env.TELEGRAM_BOT_VERIFY_INGEST_URL
+            ? "bot"
+            : "none",
+      },
+      webhook: {
+        configured: Boolean(c.env.TELEGRAM_BOT_TOKEN && (c.env.TELEGRAM_WEBHOOK_URL || c.env.TELEGRAM_WEBHOOK_ORIGIN)),
+      },
+    }, rid));
+  });
+  admin.get("/telegram/chats", requireAuth, async (c) => {
+    const rid = requestId(), db = c.get("supabase");
+    if (!await gate(c, ["admin","moderator"])) return;
+    try {
+      const { data, error: dbError } = await db.from("telegram_bot_chats").select("*,groups(name,code)").order("created_at", { ascending: false }).limit(500);
+      if (dbError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось загрузить Telegram-чаты");
+      return c.json(ok({ items: data || [] }, rid));
+    } catch (dbError) { console.error("[admin]", dbError); return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось загрузить Telegram-чаты"); }
+  });
+  admin.post("/telegram/chats/:chatId/bind", requireAuth, async (c) => {
+    const rid = requestId(), db = c.get("supabase"), chatId = (c.req.param("chatId") ?? ""), input = await bodyJson(c);
+    if (!await gate(c, ["admin","moderator"])) return;
+    const groupId = String(input?.group_id || "");
+    if (!/^-?\d{1,24}$/.test(chatId) || !UUID.test(groupId)) return error(c, rid, 422, "VALIDATION_ERROR", "Некорректный chat ID или group_id");
+    try {
+      const { data: group, error: groupError } = await db.from("groups").select("id").eq("id", groupId).eq("is_active", true).maybeSingle();
+      if (groupError || !group) return error(c, rid, 404, "NOT_FOUND", "Активная группа не найдена");
+      const { data, error: dbError } = await db.from("telegram_bot_chats").update({ group_id: groupId, is_verified: true, updated_at: new Date().toISOString() }).eq("telegram_chat_id", Number(chatId)).select("*").maybeSingle();
+      if (dbError) return error(c, rid, 503, "DB_ERROR", "Не удалось привязать Telegram-чат");
+      if (!data) return error(c, rid, 404, "NOT_FOUND", "Чат ещё не зарегистрирован ботом");
+      return c.json(ok({ chat: data }, rid));
+    } catch (dbError) { console.error("[admin]", dbError); return error(c, rid, 503, "DB_ERROR", "Не удалось привязать Telegram-чат"); }
+  });
+  admin.get("/telegram/messages", requireAuth, async (c) => {
+    const rid = requestId();
+    if (!await gate(c, ["admin", "moderator"])) return;
+    const db = createServiceClient(c.env);
+    if (!db) return error(c, rid, 503, "DB_UNAVAILABLE", "Сервисный доступ к базе не настроен");
+    const limit = Math.min(Math.max(Number(c.req.query("limit") || 100), 1), 200);
+    const chatId = c.req.query("chat_id") || "";
+    try {
+      let query = db.from("telegram_messages")
+        .select("id,telegram_chat_id,telegram_message_id,message_text,caption,telegram_date,classification,classification_confidence,processing_status,ai_reason,ai_subject_hint,ai_due_hint,created_at,telegram_homework_links(homework_id)")
+        .order("created_at", { ascending: false })
+        .limit(limit);
+      if (chatId && /^-?\d{1,24}$/.test(chatId)) query = query.eq("telegram_chat_id", Number(chatId));
+      const { data, error: dbError } = await query;
+      if (dbError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось загрузить сообщения Telegram");
+      return c.json(ok({ items: data || [] }, rid));
+    } catch (dbError) {
+      console.error("[admin:telegram-messages]", dbError);
+      return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось загрузить сообщения Telegram");
+    }
+  });
+
+  admin.post("/telegram/messages/:id/publish", requireAuth, async (c) => {
+    const rid = requestId();
+    if (!await gate(c, ["admin", "moderator"])) return;
+    const id = c.req.param("id") || "";
+    if (!UUID.test(id)) return error(c, rid, 422, "VALIDATION_ERROR", "Некорректный ID сообщения");
+    const db = createServiceClient(c.env);
+    if (!db) return error(c, rid, 503, "DB_UNAVAILABLE", "Сервисный доступ к базе не настроен");
+    try {
+      const { data: message, error: messageError } = await db.from("telegram_messages")
+        .select("*")
+        .eq("id", id)
+        .maybeSingle();
+      if (messageError) throw messageError;
+      if (!message) return error(c, rid, 404, "NOT_FOUND", "Сообщение не найдено");
+      const { data: existingLinks, error: linkError } = await db.from("telegram_homework_links")
+        .select("homework_id")
+        .eq("telegram_message_id", id)
+        .limit(1);
+      if (linkError) throw linkError;
+      if (Array.isArray(existingLinks) && existingLinks.length) {
+        return error(c, rid, 409, "ALREADY_PUBLISHED", "Задание по этому сообщению уже создано");
+      }
+      const { data: chat, error: chatError } = await db.from("telegram_bot_chats")
+        .select("*")
+        .eq("telegram_chat_id", message.telegram_chat_id)
+        .maybeSingle();
+      if (chatError) throw chatError;
+      if (!chat?.group_id || chat.is_active === false) {
+        return error(c, rid, 409, "CHAT_NOT_BOUND", "Сначала привяжите Telegram-чат к учебной группе");
+      }
+      const text = String(message.message_text || message.caption || "").trim();
+      const previousReason = String(message.ai_reason || "");
+      const classification = {
+        category: "homework" as const,
+        confidence: Math.max(0.8, Math.min(1, Number(message.classification_confidence) || 0.8)),
+        title: text.slice(0, 120) || "Задание из Telegram",
+        summary: text.slice(0, 400),
+        subjectHint: message.ai_subject_hint ? String(message.ai_subject_hint) : null,
+        dueHint: message.ai_due_hint ? String(message.ai_due_hint) : null,
+        tasks: [] as string[],
+        reason: "admin_publish",
+        provider: previousReason.startsWith("rules_")
+          ? "rules" as const
+          : previousReason.includes("cloudflare")
+            ? "cloudflare" as const
+            : previousReason.includes("gigachat")
+              ? "gigachat" as const
+              : "rules" as const,
+        model: null,
+      };
+      const published = await publishTelegramHomework(db, message, chat, classification);
+      await updateMessageClassification(db, id, classification);
+      return c.json(ok({ homework: published }, rid));
+    } catch (dbError) {
+      console.error("[admin:telegram-publish]", dbError);
+      return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось опубликовать задание");
+    }
+  });
+
+  admin.post("/telegram/set-webhook", requireAuth, async (c) => {
+    const rid = requestId();
+    if (!await gate(c, STRICT_ADMINS)) return;
+    const token = String(c.env.TELEGRAM_BOT_TOKEN || "").trim();
+    const secret = String(c.env.TELEGRAM_WEBHOOK_SECRET || "").trim();
+    const origin = String(c.env.TELEGRAM_WEBHOOK_ORIGIN || "").trim().replace(/\/$/, "");
+    const explicitWebhookUrl = String(c.env.TELEGRAM_WEBHOOK_URL || "").trim();
+    if (!token || (!origin && !explicitWebhookUrl)) return error(c, rid, 503, "TELEGRAM_NOT_CONFIGURED", "Настройте TELEGRAM_BOT_TOKEN и TELEGRAM_WEBHOOK_URL (или TELEGRAM_WEBHOOK_ORIGIN)");
+    let response: Response;
+    try {
+      response = await fetch("https://api.telegram.org/bot" + token + "/setWebhook", {
+        method: "POST",
+        headers: { "content-type": "application/json" },
+        body: JSON.stringify({ url: explicitWebhookUrl || (() => { try { const parsed = new URL(origin); if (parsed.pathname !== "/" && parsed.pathname !== "") return parsed.toString(); return origin.includes(".workers.dev") ? origin + "/api/webhook" : origin + "/api/v1/telegram/webhook"; } catch { return origin; } })(), allowed_updates: ["message","edited_message"], ...(secret ? { secret_token: secret } : {}) }),
+        signal: AbortSignal.timeout(12000),
+      });
+    } catch (dbError) { console.error("[admin]", dbError); return error(c, rid, 502, "TELEGRAM_WEBHOOK_FAILED", "Не удалось связаться с Telegram"); }
+    const result: any = await response.json().catch(() => ({}));
+    if (!response.ok || result.ok !== true) return error(c, rid, 502, "TELEGRAM_WEBHOOK_FAILED", "Telegram отклонил настройку webhook");
+    return c.json(ok({ configured: true, url: explicitWebhookUrl || (() => { try { const parsed = new URL(origin); if (parsed.pathname !== "/" && parsed.pathname !== "") return parsed.toString(); return origin.includes(".workers.dev") ? origin + "/api/webhook" : origin + "/api/v1/telegram/webhook"; } catch { return origin; } })() }, rid));
+  });
+}
diff --git a/workers/api/src/routes/admin/tests.ts b/workers/api/src/routes/admin/tests.ts
new file mode 100644
index 00000000..fbe5d33d
--- /dev/null
+++ b/workers/api/src/routes/admin/tests.ts
@@ -0,0 +1,94 @@
+import { requireAuth } from "../../middleware/auth";
+import { ok, requestId } from "../../lib/response";
+import { CONTENT_MODERATORS, UUID, bodyJson, error, gate, validText, type AdminApp } from "./shared";
+
+/**
+ * Атомарная сборка вариантов теста из пула вопросов (RPC).
+ */
+export function registerTests(admin: AdminApp) {
+
+  // MA10: атомарная сборка вариантов теста. Вместо цепочки клиентских POST'ов
+  // (тест -> по одному на каждую ссылку test_questions) всё делает один RPC:
+  // либо собраны все варианты целиком, либо не записано ничего.
+  const VARIANT_BUILDER_ERRORS: Array<[RegExp, string | ((m: RegExpMatchArray) => string)]> = [
+    [/invalid test title/, "Укажи корректное название теста (1–300 символов)."],
+    [/subject is required/, "Выбери предмет."],
+    [/subject not found/, "Предмет не найден."],
+    [/question pool is empty/, "Выбери хотя бы один вопрос из пула."],
+    [/variants must be between 1 and 20/, "Вариантов должно быть от 1 до 20."],
+    [/questions per test must be between 1 and 200/, "Вопросов в одном тесте должно быть от 1 до 200."],
+    [/time limit must not be negative/, "Лимит времени не может быть отрицательным."],
+    [/max attempts must not be negative/, "Количество попыток не может быть отрицательным."],
+    [/module does not belong to subject/, "Выбранный модуль не относится к этому предмету."],
+    [/topic does not belong to module/, "Выбранная тема не относится к этому модулю."],
+    [/eligible question pool is too small: (\d+) available, (\d+) required/, (m) => `Подходящих опубликованных вопросов: ${m[1]}, а нужно ${m[2]} на один вариант.`],
+    [/failed to assemble variant/, "Не удалось собрать вариант: вопросы закончились в пуле."],
+    [/failed to link questions/, "Не удалось привязать вопросы к варианту."],
+    [/administrator role required/, "Недостаточно прав для административной операции."],
+  ];
+  function variantBuilderMessage(rawMessage: string): string {
+    const text = String(rawMessage || "");
+    for (const [pattern, message] of VARIANT_BUILDER_ERRORS) {
+      const match = text.match(pattern);
+      if (!match) continue;
+      return typeof message === "function" ? message(match) : message;
+    }
+    return "Не удалось собрать тесты. Изменения не сохранены.";
+  }
+
+  admin.post("/tests/build-variants", requireAuth, async (c) => {
+    const rid = requestId(), db = c.get("supabase"), user = c.get("user"), input = await bodyJson(c);
+    // Сборка вариантов из платформенного пула — задача admin и moderator.
+    // Преподаватель получит создание СВОИХ тестов через teacher-маршрут, когда
+    // такой флоу появится; RPC уже пишет p_actor_id как автора (план §10).
+    if (!await gate(c, CONTENT_MODERATORS)) return;
+    const title = String(input?.title || "").trim();
+    const subjectId = String(input?.subject_id || "");
+    const questionIds = Array.isArray(input?.question_ids) ? [...new Set((input.question_ids as unknown[]).map((id) => String(id)))] : [];
+    const variants = Number(input?.variants ?? 1);
+    const perTest = Number(input?.per_test ?? 10);
+    const moduleId = input?.module_id ? String(input.module_id) : null;
+    const topicId = input?.topic_id ? String(input.topic_id) : null;
+    const timeLimitSec = input?.time_limit_sec == null || input.time_limit_sec === "" ? null : Number(input.time_limit_sec);
+    const maxAttempts = input?.max_attempts == null || input.max_attempts === "" ? null : Number(input.max_attempts);
+    const isPublished = input?.is_published === true;
+
+    if (!validText(title, 300)) return error(c, rid, 422, "VALIDATION_ERROR", "Укажи корректное название теста (1–300 символов).");
+    if (!UUID.test(subjectId)) return error(c, rid, 422, "VALIDATION_ERROR", "Выбери предмет.");
+    if (!questionIds.length || questionIds.some((id) => !UUID.test(id))) return error(c, rid, 422, "VALIDATION_ERROR", "В пуле есть некорректные ID вопросов.");
+    if (!Number.isInteger(variants) || variants < 1 || variants > 20) return error(c, rid, 422, "VALIDATION_ERROR", "Вариантов должно быть от 1 до 20.");
+    if (!Number.isInteger(perTest) || perTest < 1 || perTest > 200) return error(c, rid, 422, "VALIDATION_ERROR", "Вопросов в одном тесте должно быть от 1 до 200.");
+    if (questionIds.length < perTest) return error(c, rid, 422, "VALIDATION_ERROR", `Выбрано ${questionIds.length} вопросов, а на один вариант нужно ${perTest}.`);
+    if (timeLimitSec !== null && (!Number.isInteger(timeLimitSec) || timeLimitSec < 0)) return error(c, rid, 422, "VALIDATION_ERROR", "Лимит времени должен быть целым неотрицательным числом.");
+    if (maxAttempts !== null && (!Number.isInteger(maxAttempts) || maxAttempts < 0)) return error(c, rid, 422, "VALIDATION_ERROR", "Количество попыток должно быть целым неотрицательным числом.");
+
+    try {
+      const { data, error: rpcError } = await db.rpc("medbiohim_build_test_variants", {
+        p_actor_id: user.id,
+        p_title: title,
+        p_subject_id: subjectId,
+        p_question_ids: questionIds,
+        p_variants: variants,
+        p_per_test: perTest,
+        p_description: String(input?.description || "").trim() || null,
+        p_module_id: moduleId,
+        p_topic_id: topicId,
+        p_time_limit_sec: timeLimitSec,
+        p_max_attempts: maxAttempts,
+        p_is_published: isPublished,
+      });
+      if (rpcError) {
+        console.error("[admin:tests:build-variants]", rpcError.message, rpcError.code, rpcError.details);
+        const code = String(rpcError.code || "");
+        if (code === "42501") return error(c, rid, 403, "FORBIDDEN", variantBuilderMessage(rpcError.message));
+        if (code === "22023" || code === "P0002") return error(c, rid, 422, "VALIDATION_ERROR", variantBuilderMessage(rpcError.message));
+        // Любая другая ошибка означает откат всей транзакции: ничего не записано.
+        return error(c, rid, 503, "BUILD_FAILED", "Не удалось собрать тесты. Изменения не сохранены.");
+      }
+      return c.json(ok(data, rid), 201);
+    } catch (rpcFailure) {
+      console.error("[admin:tests:build-variants]", rpcFailure);
+      return error(c, rid, 503, "BUILD_FAILED", "Не удалось собрать тесты. Изменения не сохранены.");
+    }
+  });
+}
diff --git a/workers/api/src/routes/admin/users.ts b/workers/api/src/routes/admin/users.ts
new file mode 100644
index 00000000..4c2e3802
--- /dev/null
+++ b/workers/api/src/routes/admin/users.ts
@@ -0,0 +1,206 @@
+import { requireAuth } from "../../middleware/auth";
+import { ok, requestId } from "../../lib/response";
+import { STRICT_ADMINS, UUID, bodyJson, error, gate, type AdminApp } from "./shared";
+
+/**
+ * Пользователи, роли и академическая привязка (группа/курс/семестр).
+ */
+export function registerUsers(admin: AdminApp) {
+
+  // User and role administration is restricted to administrators only.
+  admin.get("/users", requireAuth, async (c) => {
+    const rid = requestId(), db = c.get("supabase");
+    if (!await gate(c, STRICT_ADMINS)) return;
+    // Поиск и фильтры считаются на сервере: раньше список был жёстко «последние 100»,
+    // и найти студента по почте или группе можно было только глазами по всей странице.
+    const q = (c.req.query("q") || "").trim().slice(0, 120);
+    const roleFilter = (c.req.query("role") || "").trim().toLowerCase();
+    const groupFilter = (c.req.query("group_id") || "").trim();
+    const limit = Math.min(Math.max(Number(c.req.query("limit") || 50), 1), 200);
+    const offset = Math.max(Number(c.req.query("offset") || 0), 0);
+    if (roleFilter && !["admin", "moderator", "teacher", "student"].includes(roleFilter)) {
+      return error(c, rid, 422, "VALIDATION_ERROR", "Неизвестная роль");
+    }
+    if (groupFilter && !UUID.test(groupFilter)) return error(c, rid, 422, "VALIDATION_ERROR", "Некорректный group_id");
+    const emptyPage = () => c.json(ok({ items: [], total: 0, limit, offset }, rid));
+    try {
+      let allowedIds: string[] | null = null;
+      if (roleFilter) {
+        const { data: role, error: roleError } = await db.from("roles").select("id").eq("code", roleFilter).maybeSingle();
+        if (roleError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось применить фильтр по роли");
+        if (!role?.id) return emptyPage();
+        const { data: roleRows, error: roleRowsError } = await db.from("user_roles").select("user_id").eq("role_id", role.id).limit(5000);
+        if (roleRowsError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось применить фильтр по роли");
+        allowedIds = [...new Set((roleRows || []).map((row: any) => String(row.user_id || "")).filter(Boolean))];
+        if (!allowedIds.length) return emptyPage();
+      }
+      if (groupFilter) {
+        const { data: memberRows, error: memberRowsError } = await db.from("group_memberships").select("user_id")
+          .eq("group_id", groupFilter).eq("is_active", true).limit(5000);
+        if (memberRowsError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось применить фильтр по группе");
+        const memberIds = new Set((memberRows || []).map((row: any) => String(row.user_id || "")));
+        allowedIds = allowedIds ? allowedIds.filter((id) => memberIds.has(id)) : [...memberIds];
+        if (!allowedIds.length) return emptyPage();
+      }
+      let query = db.from("users").select("id,email,full_name,course_number,semester,created_at", { count: "exact" });
+      if (allowedIds) query = query.in("id", allowedIds);
+      if (q) {
+        // Символы, ломающие синтаксис PostgREST `or`, вырезаем: поиск не должен падать от запятой.
+        const pattern = q.replace(/[%_,()]/g, " ").replace(/\s+/g, " ").trim();
+        if (pattern) query = query.or(`email.ilike.%${pattern}%,full_name.ilike.%${pattern}%`);
+      }
+      const { data, count: totalUsers, error: dbError } = await query
+        .order("created_at", { ascending: false })
+        .range(offset, offset + limit - 1);
+      if (dbError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось загрузить пользователей");
+      const ids = (data || []).map((u: any) => u.id).filter(Boolean);
+      const roleMap: Record<string, string[]> = {};
+      if (ids.length) {
+        const { data: roles, error: rolesError } = await db.from("user_roles").select("user_id,roles(code)").in("user_id", ids);
+        if (rolesError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось загрузить роли пользователей");
+        for (const row of roles || []) {
+          const role = Array.isArray((row as any).roles) ? (row as any).roles[0] : (row as any).roles;
+          (roleMap[(row as any).user_id] ||= []).push(String(role?.code || ""));
+        }
+      }
+      const userIds = (data || []).map((u: any) => u.id).filter(Boolean);
+      const groupMap: Record<string, any> = {};
+      if (userIds.length) {
+        const { data: memberships, error: membershipsError } = await db.from("group_memberships").select("user_id,group_id,groups(name,code,course_number)").in("user_id", userIds).eq("is_active", true);
+        if (membershipsError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось загрузить группы пользователей");
+        for (const membership of memberships || []) {
+          const group = Array.isArray((membership as any).groups) ? (membership as any).groups[0] : (membership as any).groups;
+          groupMap[(membership as any).user_id] = { group_id: (membership as any).group_id, group_name: group?.name || null, group_code: group?.code || null, course_number: group?.course_number || null };
+        }
+      }
+      return c.json(ok({ items: (data || []).map((u: any) => ({ ...u, roles: roleMap[u.id] || [], ...(groupMap[u.id] || {}) })), total: totalUsers ?? (data || []).length, limit, offset }, rid));
+    } catch (dbError) { console.error("[admin]", dbError); return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось загрузить пользователей"); }
+  });
+  admin.post("/users/roles", requireAuth, async (c) => {
+    const rid = requestId(), db = c.get("supabase"), user = c.get("user"), input = await bodyJson(c);
+    if (!await gate(c, STRICT_ADMINS)) return;
+    const userId = String(input?.user_id || ""), roleCode = String(input?.role || ""), action = String(input?.action || "assign");
+    if (!UUID.test(userId) || !["admin","moderator","teacher","student"].includes(roleCode) || !["assign","revoke"].includes(action)) return error(c, rid, 422, "VALIDATION_ERROR", "Некорректные user_id, role или action");
+    try {
+      const { data: role, error: roleError } = await db.from("roles").select("id,code").eq("code", roleCode).maybeSingle();
+      if (roleError || !role) return error(c, rid, 503, "ROLE_UNAVAILABLE", "Роль не найдена");
+      if (action === "revoke" && roleCode === "admin" && userId === user.id) {
+        const { data: allRoleRows, error: adminError } = await db.from("user_roles").select("user_id,roles(code)").limit(2000);
+        if (adminError) return error(c, rid, 503, "ROLE_CHECK_UNAVAILABLE", "Не удалось проверить количество администраторов");
+        const adminIds = new Set((allRoleRows || []).filter((row: any) => {
+          const roleValue = Array.isArray(row.roles) ? row.roles[0] : row.roles;
+          return roleValue?.code === "admin";
+        }).map((row: any) => row.user_id));
+        if (adminIds.size <= 1) return error(c, rid, 409, "LAST_ADMIN", "Нельзя снять роль последнего администратора");
+      }
+      if (action === "assign") {
+        const { data: existing, error: existingError } = await db.from("user_roles").select("user_id").eq("user_id", userId).eq("role_id", role.id).maybeSingle();
+        if (existingError) return error(c, rid, 503, "ROLE_WRITE_FAILED", "Не удалось проверить назначенную роль");
+        if (!existing) {
+          const { error: writeError } = await db.from("user_roles").insert({ user_id: userId, role_id: role.id });
+          if (writeError) return error(c, rid, 503, "ROLE_WRITE_FAILED", "Не удалось назначить роль");
+        }
+      } else {
+        const { error: writeError } = await db.from("user_roles").delete().eq("user_id", userId).eq("role_id", role.id);
+        if (writeError) return error(c, rid, 503, "ROLE_WRITE_FAILED", "Не удалось снять роль");
+      }
+      const { data: rows } = await db.from("user_roles").select("roles(code)").eq("user_id", userId).limit(20);
+      const roles = (rows || []).map((row: any) => { const r = Array.isArray(row.roles) ? row.roles[0] : row.roles; return String(r?.code || ""); }).filter(Boolean);
+      return c.json(ok({ roles, session_refresh_required: userId === user.id }, rid));
+    } catch (dbError) { console.error("[admin]", dbError); return error(c, rid, 503, "ROLE_WRITE_FAILED", "Не удалось изменить роли пользователя"); }
+  });
+
+  // Assign group / course / semester to a user (admin CMS).
+  admin.put("/users/:id/academic", requireAuth, async (c) => {
+    const rid = requestId(), db = c.get("supabase");
+    if (!await gate(c, STRICT_ADMINS)) return;
+    const userId = c.req.param("id") ?? "";
+    if (!UUID.test(userId)) return error(c, rid, 422, "VALIDATION_ERROR", "Некорректный ID пользователя");
+    const input = await bodyJson(c);
+    if (!input) return error(c, rid, 400, "VALIDATION_ERROR", "Некорректный JSON");
+    const groupId = String(input.group_id || "").trim();
+    if (!UUID.test(groupId)) return error(c, rid, 422, "VALIDATION_ERROR", "group_id обязателен (UUID)");
+    const semester = input.semester != null ? Number(input.semester) : null;
+    const courseNumber = input.course_number != null ? Number(input.course_number) : input.course != null ? Number(input.course) : null;
+    try {
+      const { data: group, error: groupError } = await db
+        .from("groups")
+        .select("id,name,code,course_number,is_active")
+        .eq("id", groupId)
+        .maybeSingle();
+      if (groupError) return error(c, rid, 503, "DB_UNAVAILABLE", "Не удалось проверить группу");
+      if (!group || group.is_active === false) return error(c, rid, 404, "NOT_FOUND", "Активная группа не найдена");
+
+      // Ensure the target membership is active before deactivating any previous membership.
+      const { data: existing, error: existingError } = await db
+        .from("group_memberships")
+        .select("id")
+        .eq("user_id", userId)
+        .eq("group_id", groupId)
+        .limit(1)
+        .maybeSingle();
+      if (existingError) return error(c, rid, 503, "DB_ERROR", "Не удалось проверить членство в группе");
+      if (existing?.id) {
+        const { error: mErr } = await db
+          .from("group_memberships")
+          .update({ is_active: true, role_in_group: "student" })
+          .eq("id", existing.id);
+        if (mErr) return error(c, rid, 503, "DB_ERROR", "Не удалось обновить членство в группе");
+      } else {
+        const { error: mErr } = await db.from("group_memberships").insert({
+          user_id: userId,
+          group_id: groupId,
+          role_in_group: "student",
+          is_active: true,
+        });
+        if (mErr) return error(c, rid, 503, "DB_ERROR", "Не удалось создать членство в группе");
+      }
+      const { error: deactivateError } = await db
+        .from("group_memberships")
+        .update({ is_active: false })
+        .eq("user_id", userId)
+        .neq("group_id", groupId)
+        .eq("is_active", true);
+      if (deactivateError) return error(c, rid, 503, "DB_ERROR", "Группа назначена, но не удалось закрыть прежнее членство");
+
+      const userPatch: Record<string, unknown> = { updated_at: new Date().toISOString() };
+      const resolvedSemester = semester != null && Number.isFinite(semester) ? semester : null;
+      const resolvedCourse =
+        courseNumber != null && Number.isFinite(courseNumber)
+          ? courseNumber
+          : group.course_number ?? null;
+      if (resolvedSemester != null) userPatch.semester = resolvedSemester;
+      if (resolvedCourse != null) userPatch.course_number = resolvedCourse;
+
+      const { data: userRow, error: userError } = await db
+        .from("users")
+        .update(userPatch)
+        .eq("id", userId)
+        .select("id,email,full_name,course_number,semester")
+        .maybeSingle();
+      if (userError) return error(c, rid, 503, "DB_ERROR", "Членство сохранено, но профиль users не обновлён");
+
+      return c.json(
+        ok(
+          {
+            user: userRow,
+            group_id: groupId,
+            group: {
+              id: group.id,
+              name: group.name,
+              code: group.code,
+              course: group.course_number ?? null,
+              course_number: group.course_number ?? null,
+              semester: resolvedSemester,
+            },
+            semester: userRow?.semester ?? resolvedSemester,
+            course_number: userRow?.course_number ?? resolvedCourse,
+          },
+          rid
+        )
+      );
+    } catch {
+      return error(c, rid, 503, "DB_ERROR", "Не удалось сохранить академические данные");
+    }
+  });
+}
