-/** Человекочитаемые подписи event_kind для контекста ИИ (см. study/agenda.ts). */
-const STUDY_KIND_LABELS: Record<string, string> = {
-  class: "занятие",
-  assessment: "аттестация",
-  credit: "зачёт",
-  exam: "экзамен",
-  retake: "пересдача",
