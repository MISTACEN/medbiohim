+    updated_at: new Date().toISOString(),
+  }).eq("id", conversation.id).eq("user_id", user.id);
+
+  return c.json(ok({
+    conversation: { ...conversation, title, model: generated.model },
+    user_message: userMessage,
+    assistant_message: assistantMessage,
+  }, rid));
+});
