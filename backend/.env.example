APP_ENV=production
APP_DEBUG=0
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...service_role...
DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_HOST=aws-1-eu-west-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
CORS_ORIGINS=https://medbiohim.vercel.app,http://localhost:3000
OAUTH_GOOGLE_ENABLED=1
OAUTH_VK_ENABLED=1
OAUTH_TELEGRAM_ENABLED=1
ADMIN_BOOTSTRAP_SECRET=change-me
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=medbiohim-files
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003

# Optional LLM for AI-tutor (OpenAI-compatible). Without key — local RAG still works.
LLM_API_KEY=
# OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Persistent AI chat providers
AI_CHAT_PRIMARY_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat
GIGACHAT_ACCESS_TOKEN=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_OUTPUT_TOKENS=2048

# Optional additional AI providers for testing (server-side only)
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=
