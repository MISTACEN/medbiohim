diff --git a/workers/api/test/helpers/admin-routes.js b/workers/api/test/helpers/admin-routes.js
new file mode 100644
index 00000000..e88bac71
--- /dev/null
+++ b/workers/api/test/helpers/admin-routes.js
@@ -0,0 +1,33 @@
+import { readFile } from "node:fs/promises";
+
+/**
+ * Исходник админ-маршрутов, собранный из доменных файлов.
+ *
+ * Контрактные тесты проверяют наличие маршрутов и проверок по тексту. После
+ * разнесения монолита routes/admin.ts на домены они читают ту же сборку,
+ * которую монтирует routes/admin/index.ts — без ослабления проверок.
+ */
+export const ADMIN_SOURCE_FILES = [
+  "shared.ts",
+  "overview.ts",
+  "questions.ts",
+  "tests.ts",
+  "lectures.ts",
+  "users.ts",
+  "telegram.ts",
+  "content.ts",
+  "files.ts",
+  "schedule.ts",
+  "announcements.ts",
+  "presence.ts",
+  "index.ts",
+];
+
+export async function adminRoutesSource() {
+  const parts = await Promise.all(
+    ADMIN_SOURCE_FILES.map((file) =>
+      readFile(new URL(`../../src/routes/admin/${file}`, import.meta.url), "utf8"),
+    ),
+  );
+  return parts.join("\n");
+}
diff --git a/workers/api/test/page-source.js b/workers/api/test/page-source.js
new file mode 100644
index 00000000..3730b6e3
--- /dev/null
+++ b/workers/api/test/page-source.js
@@ -0,0 +1,33 @@
+// Страницы разнесены по доменам: тест читает саму страницу и те файлы
+// components/*, которые она импортирует. Иначе проверки, привязанные к тексту
+// страницы, «проходят» по пустому месту после переноса кода.
+import { existsSync, readFileSync } from "node:fs";
+
+const SRC = new URL("../../../src/", import.meta.url);
+
+export function readPageWithDomain(relative, depth = 3) {
+  const page = readFileSync(new URL(relative, SRC), "utf8");
+  const parts = [page];
+  const seen = new Set();
+  let frontier = [page];
+  for (let level = 0; level < depth && frontier.length; level += 1) {
+    const next = [];
+    for (const text of frontier) {
+      for (const match of text.matchAll(/@\/components\/([A-Za-z0-9_.-]+)\/([A-Za-z0-9_/-]+)/g)) {
+        const key = match[1] + "/" + match[2];
+        if (seen.has(key)) continue;
+        seen.add(key);
+        for (const candidate of [key + ".tsx", key + ".ts", key + "/index.tsx", key + "/index.ts"]) {
+          const url = new URL("components/" + candidate, SRC);
+          if (!existsSync(url)) continue;
+          const content = readFileSync(url, "utf8");
+          parts.push(content);
+          next.push(content);
+          break;
+        }
+      }
+    }
+    frontier = next;
+  }
+  return parts.join("\n");
+}
