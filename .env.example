# MEDBIOHIM — Vercel / frontend
# Never commit real secrets.

NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY>
NEXT_PUBLIC_APP_NAME=Медбиохим

# Cloudflare Workers API only (must end with /api/v1)
CLOUDFLARE_API_ORIGIN=https://medbiohim-api.YOUR_SUBDOMAIN.workers.dev/api/v1

# Optional Vercel-side Gemini proxy for AI features.
GEMINI_API_KEY=
GEMINI_VERCEL_PROXY_SECRET=
