+          type="button"
+          onClick={startNew}
+          className="inline-flex items-center gap-1.5 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700"
+        >
+          <FilePlus2 className="h-4 w-4" /> Новая аттестация
