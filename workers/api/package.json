{
  "name": "medbiohim-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MEDBIOHIM production API on Cloudflare Workers (Hono + Supabase + Upstash)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "check": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@upstash/blob": "0.0.11",
    "@upstash/redis": "^1.34.3",
    "hono": "^4.6.12",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
