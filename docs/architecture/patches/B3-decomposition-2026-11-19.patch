-      if (entry.anchor >= 0) {
-        const start = Math.max(0, entry.anchor - 120);
-        fragment = (start > 0 ? "…" : "") + entry.body.slice(start, start + FRAGMENT).trim() + (start + FRAGMENT < entry.body.length ? "…" : "");
-      } else {
