+                  <CheckCircle2 className="h-5 w-5" />
+                </button>
+                <div className="min-w-0 flex-1">
+                  <b className={hs === "done" ? "line-through opacity-60" : ""}>{h.title}</b>
+                  <div className="mt-0.5 flex flex-wrap items-center gap-1.5 text-xs opacity-70">
