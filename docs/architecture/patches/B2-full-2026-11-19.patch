+ * теперь только собирает разметку из видов (неделя/день/месяц/семестр) и
+ * панели занятия.
+ */
+import { useEffect, useMemo, useState, useRef } from "react";
+import {
+  listSchedule,
+  getScheduleMeta,
+  getStudentPlanner,
+  markAttendance,
+  hasToken,
