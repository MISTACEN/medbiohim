diff --git a/workers/api/src/routes/srs/fsrs.ts b/workers/api/src/routes/srs/fsrs.ts
new file mode 100644
index 00000000..b9862037
--- /dev/null
+++ b/workers/api/src/routes/srs/fsrs.ts
@@ -0,0 +1,113 @@
+
+export const FSRS_W = [
+  0.5701, 1.4436, 4.1386, 10.9355, 5.1443, 1.2006, 0.8627, 0.0362, 1.629,
+  0.1342, 1.0166, 2.1174, 0.0839, 0.3204, 1.4676, 0.219, 2.8237,
+];
+export const FSRS_RETENTION = 0.9;
+export const FSRS_MAX_STABILITY = 36500;
+
+export function fsrsIntervalDays(stability: number): number {
+  // Дни, за которые удержание падает до FSRS_RETENTION: при 0.9 → ровно S.
+  const factor = Math.pow(1 / FSRS_RETENTION, 2) - 1;
+  return Math.max(1, Math.round(stability * factor * (81 / 19)));
+}
+
+export function fsrsNextDifficulty(difficulty: number, rating: number): number {
+  const delta = -FSRS_W[5] * (rating - 3);
+  return Math.min(10, Math.max(1, difficulty + (delta * (10 - difficulty)) / 9));
+}
+
+export type FsrsCardState = {
+  ease?: number | string | null;
+  interval?: number | string | null;
+  reps?: number | string | null;
+  reviewed_at?: string | null;
+  stability?: number | string | null;
+  difficulty?: number | string | null;
+  state?: number | string | null;
+  lapses?: number | string | null;
+};
+
+export function nextReviewState(card: FsrsCardState, rating: number) {
+  const now = new Date();
+  const ratingKey = Math.min(4, Math.max(1, Math.round(Number(rating) || 3)));
+
+  const prevStability = Number(card.stability ?? 0);
+  const prevDifficulty = Number(card.difficulty ?? 0);
+  const prevState = Number(card.state ?? 0);
+  const isNew = prevState === 0 || !(prevStability > 0);
+
+  let stability: number;
+  let difficulty: number;
+  if (isNew) {
+    stability = Math.max(0.1, FSRS_W[ratingKey - 1]);
+    difficulty = Math.min(10, Math.max(1, FSRS_W[3] - FSRS_W[4] * (ratingKey - 3)));
+  } else {
+    // Удержание на момент проверки по кривой забывания R(t,S) = (1+F·t/S)^-0.5.
+    const lastReviewed = card.reviewed_at ? new Date(String(card.reviewed_at)).getTime() : NaN;
+    const elapsed = Number.isFinite(lastReviewed)
+      ? Math.max(0, (now.getTime() - lastReviewed) / 86400_000)
+      : Math.max(0, Number(card.interval ?? 0));
+    const retrievability = 1 / Math.pow(1 + (19 / 81) * (elapsed / prevStability), 0.5);
+    if (ratingKey === 1) {
+      stability = Math.min(
+        FSRS_MAX_STABILITY,
+        Math.max(0.1,
+          FSRS_W[10] * Math.pow(prevDifficulty, -FSRS_W[11])
+          * (Math.pow(prevStability + 1, FSRS_W[12]) - 1)
+          * Math.exp((1 - retrievability) * FSRS_W[13])),
+      );
+    } else {
+      const hard = ratingKey === 2 ? FSRS_W[14] : 1;
+      const easy = ratingKey === 4 ? FSRS_W[15] : 1;
+      stability = Math.min(
+        FSRS_MAX_STABILITY,
+        Math.max(0.1,
+          prevStability
+          * (1 + Math.exp(FSRS_W[7]) * (11 - prevDifficulty)
+            * Math.pow(prevStability, -FSRS_W[8])
+            * (Math.exp((1 - retrievability) * FSRS_W[9]) - 1)
+            * hard * easy)),
+      );
+    }
+    difficulty = fsrsNextDifficulty(prevDifficulty, ratingKey);
+  }
+
+  const interval = fsrsIntervalDays(stability);
+
+  // SM-2-совместимость: ease/interval/reps продолжают жить рядом.
+  let ease = Number(card.ease ?? 2.5);
+  let legacyInterval = Number(card.interval ?? 0);
+  let reps = Number(card.reps ?? 0);
+  if (ratingKey === 1) {
+    reps = 0;
+    legacyInterval = 1;
+    ease = Math.max(1.3, ease - 0.2);
+  } else if (ratingKey === 2) {
+    reps += 1;
+    legacyInterval = Math.max(1, Math.ceil(Math.max(1, legacyInterval) * 1.4));
+    ease = Math.max(1.3, ease - 0.05);
+  } else if (ratingKey === 3) {
+    reps += 1;
+    legacyInterval = legacyInterval > 0 ? Math.max(1, Math.ceil(legacyInterval * ease)) : 1;
+  } else {
+    reps += 1;
+    legacyInterval = legacyInterval > 0 ? Math.max(1, Math.ceil(legacyInterval * ease * 1.3)) : 2;
+    ease = Math.min(3.2, ease + 0.15);
+  }
+
+  const wasNew = isNew;
+  const state = ratingKey === 1 ? (wasNew ? 1 : 3) : 2;
+  const lapses = Number(card.lapses ?? 0) + (ratingKey === 1 && !wasNew ? 1 : 0);
+
+  return {
+    ease: Number(ease.toFixed(2)),
+    interval,
+    reps,
+    due_at: new Date(now.getTime() + interval * 86400_000).toISOString(),
+    stability: Number(stability.toFixed(4)),
+    difficulty: Number(difficulty.toFixed(4)),
+    state,
+    lapses,
+  };
+}
diff --git a/workers/api/src/routes/srs/shared.ts b/workers/api/src/routes/srs/shared.ts
new file mode 100644
index 00000000..f5c33ba4
--- /dev/null
+++ b/workers/api/src/routes/srs/shared.ts
@@ -0,0 +1,139 @@
+
+
+export const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
+export const CARD_FIELDS =
+  "id,user_id,source_type,source_id,front,back,subject_id,subject_slug,topic,ease,interval,reps,due_at,reviewed_at,stability,difficulty,state,lapses,created_at,updated_at";
+
+export type SrsRow = {
+  id?: string;
+  user_id?: string;
+  source_type?: string | null;
+  source_id?: string | null;
+  front?: string | null;
+  back?: string | null;
+  subject_id?: string | null;
+  subject_slug?: string | null;
+  topic?: string | null;
+  ease?: number | string | null;
+  interval?: number | string | null;
+  reps?: number | string | null;
+  due_at?: string | null;
+  reviewed_at?: string | null;
+};
+
+export function toEpoch(value: unknown, fallback: number): number {
+  const parsed = Date.parse(String(value || ""));
+  return Number.isFinite(parsed) ? Math.round(parsed / 1000) : fallback;
+}
+
+export function formatCard(row: SrsRow, subjectNames: Map<string, string>, now: number) {
+  const subjectSlug = String(row.subject_slug || "");
+  const subjectName = subjectNames.get(subjectSlug) || "";
+  const dueAt = toEpoch(row.due_at, now);
+  return {
+    id: String(row.id || ""),
+    front: String(row.front || ""),
+    back: String(row.back || ""),
+    subject: subjectName || subjectSlug,
+    subject_slug: subjectSlug,
+    topic: String(row.topic || ""),
+    source: row.source_type === "personal" ? "personal" : "question",
+    ease: Number(row.ease ?? 2.5),
+    interval: Number(row.interval ?? 0),
+    reps: Number(row.reps ?? 0),
+    due_at: dueAt,
+    due_in_hours: Math.round(((dueAt - now) / 3600) * 10) / 10,
+    reviewed_at: row.reviewed_at || null,
+  };
+}
+
+export async function subjectNames(supabase: any): Promise<Map<string, string>> {
+  const names = new Map<string, string>();
+  try {
+    const { data } = await supabase
+      .from("subjects")
+      .select("name,slug")
+      .eq("is_active", true)
+      .limit(500);
+    for (const row of data || []) {
+      const slug = String((row as any).slug || "");
+      if (slug) names.set(slug, String((row as any).name || ""));
+    }
+  } catch {
+    // Subject names are decorative; cards still render with the slug.
+  }
+  return names;
+}
+
+export async function loadCards(supabase: any, userId: string, limit: number): Promise<SrsRow[]> {
+  const { data, error } = await supabase
+    .from("srs_cards")
+    .select(CARD_FIELDS)
+    .eq("user_id", userId)
+    .order("due_at", { ascending: true })
+    .limit(limit);
+  if (error) throw error;
+  return (data || []) as SrsRow[];
+}
+
+export function filterCards(
+  rows: SrsRow[],
+  options: { subjectId?: string | null; subjectSlug?: string | null; scope?: string | null },
+): SrsRow[] {
+  const subjectId = String(options.subjectId || "");
+  const subjectSlug = String(options.subjectSlug || "");
+  const scope = String(options.scope || "");
+  return rows.filter((row) => {
+    const source = row.source_type === "personal" ? "personal" : "question";
+    if (scope === "shared" && source !== "question") return false;
+    if (scope === "personal" && source !== "personal") return false;
+    if (subjectId) return String(row.subject_id || "") === subjectId;
+    if (subjectSlug) return String(row.subject_slug || "") === subjectSlug;
+    return true;
+  });
+}
+
+export function summarize(rows: SrsRow[], subjectNamesBySlug: Map<string, string>, newAvailable: number) {
+  const now = Math.round(Date.now() / 1000);
+  let due = 0;
+  let learning = 0;
+  const subjects = new Map<string, { subject: string; subject_slug: string; count: number }>();
+  for (const row of rows) {
+    if (toEpoch(row.due_at, now) <= now) due += 1;
+    if (Number(row.reps ?? 0) > 0 && Number(row.interval ?? 0) < 2) learning += 1;
+    const slug = String(row.subject_slug || "");
+    if (!slug) continue;
+    const entry = subjects.get(slug) || {
+      subject: subjectNamesBySlug.get(slug) || slug,
+      subject_slug: slug,
+      count: 0,
+    };
+    entry.count += 1;
+    subjects.set(slug, entry);
+  }
+  return {
+    due,
+    learning,
+    total: rows.length,
+    new_available: newAvailable,
+    subjects: [...subjects.values()].sort((a, b) => b.count - a.count),
+  };
+}
+
+export async function countNewQuestions(supabase: any, cards: SrsRow[]): Promise<number> {
+  const covered = new Set(
+    cards.filter((row) => row.source_type === "question" && row.source_id).map((row) => String(row.source_id)),
+  );
+  try {
+    const { data, error } = await supabase
+      .from("questions")
+      .select("id")
+      .eq("is_published", true)
+      .is("archived_at", null)
+      .limit(2000);
+    if (error) return 0;
+    return (data || []).filter((row: any) => !covered.has(String(row.id))).length;
+  } catch {
+    return 0;
+  }
+}
