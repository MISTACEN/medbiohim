# MEDBIOHIM — SpaceWeb/PHP runtime configuration
# Placeholder template only. Never commit real credentials or API keys.

APP_ENV=production
APP_DEBUG=0

# Supabase server-side / auth
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=<SUPABASE_PUBLISHABLE_OR_LEGACY_ANON_KEY>
SUPABASE_SERVICE_KEY=<SUPABASE_SERVICE_OR_SECRET_KEY>
SUPABASE_SECRET_KEY=<SUPABASE_SECRET_KEY>
SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL pooler
DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DB_HOST=POOLER_HOST
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10

# API/runtime
CORS_ORIGINS=https://YOUR-VERCEL-DOMAIN,https://YOUR-SPACEWEB-DOMAIN,http://localhost:3000
ADMIN_BOOTSTRAP_SECRET=change-me
# Encryption key for saved external database passwords. Keep server-side only.
DB_CREDENTIALS_KEY=

# Backblaze B2
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=medbiohim-files
# Shared private media lives in Upstash Blob. Supabase stores metadata and access relations.
# Set the Cloudflare Worker base URL including /api/v1 (no trailing slash).
MEDBIOHIM_CLOUDFLARE_API_URL=https://medbiohim-api.ryazansevegor.workers.dev/api/v1
# CLI-only migration secret: a current admin Supabase access token; do not commit real values.
MEDBIOHIM_MIGRATION_BEARER_TOKEN=
B2_ENDPOINT=s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_BUCKET_ID=

# Firebase полностью выведен из эксплуатации: база и вход на Supabase (см. docs/ENV-CONFIG-MAP.md).

# AI provider layer — optional; core platform must work without these keys.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_MODE=generate_content
GOOGLE_CLOUD_PROJECT=
VERTEX_PROJECT=
VERTEX_LOCATION=europe-west1

GIGACHAT_CREDENTIALS=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_ACCESS_TOKEN=
GIGACHAT_VERIFY_SSL=0

LLM_PROVIDER=auto
LLM_MODE=hybrid
LLM_ALLOW_GLOBAL=1
LLM_TIMEOUT_SEC=60
LLM_VISION_PROVIDER=auto
MEDIA_REGION_DEFAULT=ru

GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=https://api.groq.com/openai/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_BASE_URL=https://api.mistral.ai/v1

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_VISION_MODEL=

AI_CHAT_PRIMARY_PROVIDER=groq

# Optional Gemini Vercel proxy when backend network policy blocks direct Gemini calls.
GEMINI_VERCEL_PROXY_URL=
GEMINI_VERCEL_PROXY_SECRET=
